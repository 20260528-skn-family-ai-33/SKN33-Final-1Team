{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poster-case.schema.json",
  "title": "지역행사 포스터 검수 케이스 v0.1 (JSONL 한 줄 = 케이스 하나)",
  "description": "입력(input) · 정답(gold: extraction + checks) · 라벨 메타(label_meta)로 이루어진 데이터셋 한 건. 모델 실행 결과와 검수 시간 측정은 이 스키마에 넣지 않고 별도 스키마로 분리한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "domain",
    "media_type",
    "source",
    "input",
    "gold",
    "label_meta"
  ],
  "properties": {
    "schema_version": {
      "const": "poster-case/0.1"
    },
    "case_id": {
      "$ref": "#/$defs/case_id",
      "description": "원본은 EVT-0001, 변형은 EVT-0001-v1"
    },
    "domain": {
      "const": "regional_event",
      "description": "v0.1은 지역행사만 정의한다. 다른 도메인은 gold.extraction.fields·input.reference의 도메인 부분을 교체하는 어댑터로 추가한다."
    },
    "media_type": {
      "const": "image",
      "description": "video는 예약. 이미지와 영상은 전처리 경로가 달라 입력 구조를 따로 정의해야 한다."
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "input": {
      "$ref": "#/$defs/input"
    },
    "gold": {
      "$ref": "#/$defs/gold"
    },
    "label_meta": {
      "$ref": "#/$defs/label_meta"
    }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "description": "[x, y, w, h] 0~1 비율. 이미지 왼쪽 위가 원점이며 앱 region 형식과 같다. 픽셀은 input.image의 width·height로 환산한다."
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "hex": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "weekday": {
      "enum": [
        "월",
        "화",
        "수",
        "목",
        "금",
        "토",
        "일"
      ]
    },
    "text_id": {
      "type": "string",
      "pattern": "^T\\d{2,}$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^O\\d{2,}$"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[TO]\\d{2,}$"
    },
    "check_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,3}-\\d{2}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^EVT-\\d{4}(-v\\d+)?$"
    },
    "text_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text_id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "grounded_string": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "text_ids"
      ],
      "description": "구조화한 값과 그 값이 보이는 글자 영역(texts의 id)을 함께 적는다.",
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "text_ids": {
          "$ref": "#/$defs/text_ids"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "provenance",
        "rights"
      ],
      "properties": {
        "origin": {
          "enum": [
            "real_public",
            "real_provided",
            "synthetic",
            "synthetic_variant"
          ],
          "description": "real_public 공개된 실제 포스터 / real_provided 의뢰·제공받은 실제 포스터 / synthetic 처음부터 만든 포스터 / synthetic_variant 원본에 오류를 주입한 변형"
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "description": "어디서 어떻게 얻었는지(출처·생성 방법)"
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "description": "데이터를 판매·공유하려면 케이스마다 권리 상태를 알아야 한다.",
          "properties": {
            "status": {
              "enum": [
                "confirmed",
                "unconfirmed",
                "not_required"
              ]
            },
            "license": {
              "type": [
                "string",
                "null"
              ]
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "variant_of": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^EVT-\\d{4}(-v\\d+)?$"
        },
        "perturbations": {
          "type": "array",
          "description": "변형 케이스에서 어떤 오류를 어디에 주입했는지. 정답(checks의 fail)의 근거가 된다.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "target_id",
              "check_ids"
            ],
            "properties": {
              "op": {
                "enum": [
                  "text_replace",
                  "text_delete",
                  "text_add",
                  "weekday_swap",
                  "date_shift",
                  "font_change",
                  "color_change",
                  "overlap",
                  "clip",
                  "other"
                ]
              },
              "target_id": {
                "$ref": "#/$defs/target_id"
              },
              "from": {},
              "to": {},
              "check_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/check_id"
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "synthetic_variant"
              }
            },
            "required": [
              "origin"
            ]
          },
          "then": {
            "required": [
              "variant_of",
              "perturbations"
            ],
            "properties": {
              "variant_of": {
                "type": "string"
              },
              "perturbations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "description": "선택. 발주서·공식 행사 정보처럼 포스터를 비교할 기준. 없으면 기준이 필요한 검사는 needs_review(reason_code=needs_reference)가 된다.",
      "properties": {
        "event": {
          "type": "object",
          "additionalProperties": false,
          "description": "도메인 어댑터(지역행사) 기준 정보",
          "properties": {
            "name": {
              "type": "string"
            },
            "start_date": {
              "$ref": "#/$defs/date"
            },
            "end_date": {
              "$ref": "#/$defs/date"
            },
            "venues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "organizer": {
              "type": "string"
            },
            "start_time": {
              "$ref": "#/$defs/time"
            },
            "end_time": {
              "$ref": "#/$defs/time"
            },
            "admission_fee": {
              "type": "string"
            },
            "contact": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          }
        },
        "design_guide": {
          "type": "object",
          "additionalProperties": false,
          "description": "컬러 시스템·폰트 등 디자인 기준",
          "properties": {
            "palette": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "role",
                  "hex"
                ],
                "properties": {
                  "role": {
                    "type": "string"
                  },
                  "hex": {
                    "$ref": "#/$defs/hex"
                  }
                }
              }
            },
            "fonts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "role",
                  "family"
                ],
                "properties": {
                  "role": {
                    "type": "string"
                  },
                  "family": {
                    "type": "string"
                  }
                }
              }
            },
            "min_text_height_ratio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "logos": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "path"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "required_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "event_name",
              "dates",
              "time",
              "venues",
              "organizers",
              "contact",
              "admission_fee"
            ]
          },
          "description": "이 행사에서 반드시 있어야 하는 정보. 없으면 카탈로그의 REQ-01 기본 세트를 쓴다."
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image"
      ],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "width",
            "height",
            "format"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "format": {
              "enum": [
                "png",
                "jpeg",
                "webp"
              ]
            },
            "sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$",
              "description": "이미지가 아직 만들어지지 않았으면 null"
            }
          }
        },
        "reference": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "text_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "text",
        "bbox",
        "legibility"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text_id"
        },
        "role": {
          "enum": [
            "event_name",
            "edition_year",
            "date",
            "time",
            "venue",
            "organizer",
            "slogan",
            "body",
            "contact",
            "url",
            "admission_fee",
            "sponsor",
            "caption",
            "other"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "보이는 그대로 전사한다. 오타가 있어도 고치지 않는다(정오 판정은 checks에서)."
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "legibility": {
          "enum": [
            "clear",
            "partial",
            "ambiguous"
          ],
          "description": "clear 사람이 확실히 읽음 / partial 일부만 / ambiguous 철자 확정 불가"
        },
        "font": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "family": {
              "type": [
                "string",
                "null"
              ]
            },
            "weight": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "color": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fill": {
              "oneOf": [
                {
                  "$ref": "#/$defs/hex"
                },
                {
                  "type": "null"
                }
              ]
            },
            "stroke": {
              "oneOf": [
                {
                  "$ref": "#/$defs/hex"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "attr_source": {
          "enum": [
            "generator",
            "annotator",
            "estimated"
          ],
          "description": "font·color 값의 출처. 합성 포스터는 generator(정확), 실제 포스터는 annotator 또는 estimated"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "object_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "bbox"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/object_id"
        },
        "kind": {
          "enum": [
            "logo",
            "mascot",
            "illustration",
            "icon",
            "badge",
            "shape",
            "qr_code",
            "photo"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        }
      }
    },
    "event_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_name",
        "event_year",
        "dates",
        "time",
        "venues",
        "organizers",
        "contact",
        "admission_fee"
      ],
      "description": "도메인 어댑터(지역행사). 모든 키를 반드시 적고, 포스터에 없는 정보는 null(배열은 빈 배열)로 명시한다.",
      "properties": {
        "event_name": {
          "oneOf": [
            {
              "$ref": "#/$defs/grounded_string"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_year": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "text_ids"
              ],
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 1900,
                  "maximum": 2100
                },
                "text_ids": {
                  "$ref": "#/$defs/text_ids"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "dates": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end",
                "start_weekday",
                "end_weekday",
                "text_ids"
              ],
              "properties": {
                "start": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/date"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "end": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/date"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "start_weekday": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/weekday"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "포스터에 표기된 요일(계산값 아님)"
                },
                "end_weekday": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/weekday"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "text_ids": {
                  "$ref": "#/$defs/text_ids"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "time": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end",
                "text_ids"
              ],
              "properties": {
                "start": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/time"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "end": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/time"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "text_ids": {
                  "$ref": "#/$defs/text_ids"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "venues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grounded_string"
          }
        },
        "organizers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "form",
              "name"
            ],
            "properties": {
              "role": {
                "enum": [
                  "host",
                  "organizer",
                  "sponsor",
                  "unspecified"
                ],
                "description": "host 주최 / organizer 주관 / sponsor 후원·협찬 / unspecified 역할 문구 없음"
              },
              "form": {
                "enum": [
                  "text",
                  "logo",
                  "both"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "text_ids": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/text_id"
                },
                "uniqueItems": true
              },
              "object_ids": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/object_id"
                },
                "uniqueItems": true
              }
            }
          }
        },
        "contact": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "phone",
                "url",
                "qr"
              ],
              "properties": {
                "phone": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "qr": {
                  "type": "boolean"
                },
                "text_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/text_id"
                  },
                  "uniqueItems": true
                },
                "object_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/object_id"
                  },
                  "uniqueItems": true
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "admission_fee": {
          "oneOf": [
            {
              "$ref": "#/$defs/grounded_string"
            },
            {
              "type": "null"
            }
          ]
        },
        "slogans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grounded_string"
          }
        }
      }
    },
    "check_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "verdict"
      ],
      "description": "정답(기대 출력) 한 항목. check_id의 정의는 check-catalog.json에 있다.",
      "properties": {
        "check_id": {
          "$ref": "#/$defs/check_id"
        },
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "needs_review",
            "not_applicable"
          ],
          "description": "pass 충족 / fail 미충족 / needs_review 확인 필요 / not_applicable 해당 없음"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "description": "생략하면 카탈로그의 default_severity"
        },
        "reason_code": {
          "enum": [
            "needs_reference",
            "human_judgment",
            "low_confidence",
            "not_determinable_from_image",
            "missing_recommended"
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target_id"
          },
          "uniqueItems": true,
          "description": "판정의 근거가 되는 글자·객체 id"
        },
        "observed": {
          "description": "포스터에서 관찰한 값"
        },
        "expected": {
          "description": "기대한 값(기준 정보 또는 규칙에서 나온 값)"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "message"
          ],
          "properties": {
            "type": {
              "enum": [
                "typo",
                "wrong_value",
                "mismatch_reference",
                "missing_required",
                "inconsistency",
                "low_contrast",
                "overlap",
                "clipping",
                "style_violation",
                "other"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "correction": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "needs_review"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "required": [
              "reason_code"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "fail"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "required": [
              "error",
              "targets"
            ],
            "properties": {
              "targets": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "not_applicable"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "required": [
              "note"
            ]
          }
        }
      ]
    },
    "gold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extraction",
        "checks"
      ],
      "description": "정답. extraction은 \"포스터에 무엇이 적혀 있나\", checks는 \"무엇이 잘못됐나\"이다.",
      "properties": {
        "extraction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "texts",
            "fields"
          ],
          "properties": {
            "texts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/text_item"
              }
            },
            "objects": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/object_item"
              }
            },
            "fields": {
              "$ref": "#/$defs/event_fields"
            }
          }
        },
        "checks": {
          "type": "array",
          "uniqueItems": false,
          "items": {
            "$ref": "#/$defs/check_result"
          },
          "description": "라벨링한 검사만 넣는다. 빠진 검사는 \"정답 없음\"이라 평가에서 제외한다."
        }
      }
    },
    "label_meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label_status",
        "catalog_version",
        "created_at"
      ],
      "properties": {
        "label_status": {
          "enum": [
            "draft_ai",
            "human_reviewed",
            "adjudicated"
          ],
          "description": "draft_ai AI 초안(사람 미검토) / human_reviewed 사람이 검토 / adjudicated 의견이 갈려 합의함"
        },
        "catalog_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$",
          "description": "라벨링에 쓴 check-catalog.json 버전"
        },
        "created_at": {
          "$ref": "#/$defs/date"
        },
        "annotators": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "개인 이름 대신 작업자 id"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
