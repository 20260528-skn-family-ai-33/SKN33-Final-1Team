FROM node:22-bookworm-slim AS web
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /usr/local/bin/uv
ENV PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev
COPY backend/__init__.py backend/__init__.py
COPY backend/creative_checker/ backend/creative_checker/
COPY start.py ./
COPY --from=web /build/frontend/dist/ /app/frontend/dist/
RUN useradd --system --uid 10001 --create-home checker && mkdir /app/data && chown checker:checker /app/data
USER checker
EXPOSE 8000
CMD ["/app/.venv/bin/uvicorn", "backend.creative_checker.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers", "--no-access-log"]
