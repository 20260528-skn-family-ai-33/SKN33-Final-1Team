# Explicit Linux v1 API. Build React separately and mount its v1 dist read-only.
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/creative
COPY requirements-db.txt requirements-v1.txt ./
RUN pip install --no-cache-dir -r requirements-v1.txt \
    && useradd --uid 10001 --create-home creative \
    && mkdir /data && chown creative:creative /data \
    && touch /opt/creative/app.env
COPY backend/__init__.py backend/__init__.py
COPY backend/app backend/app
COPY scripts/__init__.py scripts/__init__.py
COPY scripts/run_v1.py scripts/prepare_paddle.py scripts/
USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "scripts.run_v1", "--env-file", "/opt/creative/app.env", "--host", "0.0.0.0", "--port", "8000"]
