PUBLIC_ORIGIN=https://review.rayd.cc
DEMO_USERNAME=reviewer
# 16자 이상의 별도 시연 비밀번호. 이 파일을 복사한 .env는 Git에 넣지 않는다.
DEMO_PASSWORD=
# 시연 도메인에서 개발 계정도 허용하려면 1. 기본값은 0이다.
DEMO_ALLOW_LOCAL_ADMIN=0
# 32자 이상의 무작위 값. Pages의 API_PROXY_SECRET과 같은 값을 사용한다.
API_PROXY_SECRET=
# 이 서비스 전용 Cloudflare Tunnel의 실행 토큰.
TUNNEL_TOKEN=
