# Optional real local-CPU worker image. Models are verified external read-only input.
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/creative
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 libglib2.0-0 libgl1 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-db.txt requirements-v1.txt requirements-paddle.txt ./
RUN pip install --no-cache-dir -r requirements-v1.txt \
    && python -m venv /opt/creative/.runtime/paddle-env \
    && .runtime/paddle-env/bin/pip install --no-cache-dir -r requirements-paddle.txt \
    && useradd --uid 10001 --create-home creative \
    && mkdir -p /data /opt/creative/.runtime/paddlex /opt/creative/.runtime/model-cache \
    && chown -R creative:creative /data /opt/creative/.runtime/paddlex /opt/creative/.runtime/model-cache \
    && touch /opt/creative/app.env
COPY backend/__init__.py backend/__init__.py
COPY backend/app backend/app
COPY scripts/__init__.py scripts/prepare_paddle.py scripts/
USER 10001:10001
CMD ["python", "-m", "backend.app.worker", "--env-file", "/opt/creative/app.env"]
