# Render ONLY CC_* variables (nginx variables must remain literal).
# The API port must remain private. TRUSTED_PROXY_IPS is this proxy's exact IP.
server {
    listen 443 ssl default_server;
    server_name ${CC_SERVER_NAME};
    ssl_certificate ${CC_TLS_CERT};
    ssl_certificate_key ${CC_TLS_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    access_log off;
    error_log /dev/stderr warn;
    client_max_body_size 21m;
    client_body_timeout 30s;
    keepalive_timeout 30s;
    if ($host != ${CC_SERVER_NAME}) { return 444; }
    # Docker DNS; on another host use its explicit private resolver/upstream.
    resolver 127.0.0.11 ipv6=off valid=10s;
    set $cc_upstream ${CC_UPSTREAM};
    location / {
        proxy_pass http://$cc_upstream;
        proxy_http_version 1.1;
        proxy_intercept_errors off;
        # Rebuild the allowlist instead of trusting any client Forwarded/X-Forwarded-*.
        proxy_pass_request_headers off;
        proxy_set_header Host $http_host;
        proxy_set_header Origin $http_origin;
        proxy_set_header Referer $http_referer;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-CSRFToken $http_x_csrftoken;
        proxy_set_header Idempotency-Key $http_idempotency_key;
        proxy_set_header Content-Type $http_content_type;
        proxy_set_header Accept $http_accept;
        proxy_set_header User-Agent $http_user_agent;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 150s;
        proxy_send_timeout 30s;
    }
}
