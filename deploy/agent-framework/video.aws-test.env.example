# Copy these non-secret values into the existing video service environment.
# The EC2 loopback tunnel must reach the video vLLM server before switching the API.
VIDEO_SUBTITLE_ENGINE=qwen3-vl
VIDEO_SUBTITLE_VLM_URL=http://127.0.0.1:18000/v1
VIDEO_SUBTITLE_VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
# Set VIDEO_SUBTITLE_VLM_API_KEY in the private runtime environment if vLLM requires it.
VIDEO_MAX_SECONDS=180
VIDEO_MAX_MB=1024
VIDEO_MAX_ACTIVE=2
