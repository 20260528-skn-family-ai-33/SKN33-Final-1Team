# Copy to a NEW private .runtime/framework-desktop.env.
# Connect to your EXISTING development M008 database. No DB is created here.
PERSISTENCE_MODE=postgres
APP_ENV=development
LOCAL_ADMIN_LOGIN=0
DB_HOST=host.docker.internal
DB_PORT=5432
POSTGRES_DB=existing_database
DB_APP_USER=existing_app_role
DB_APP_PASSWORD=change-me-existing-app-password
AUTH_ALLOWED_ORIGINS=http://localhost:8012,http://127.0.0.1:8012
AUTH_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_SECRET=change-me-distinct-random-secret-at-least-32-bytes
CURSOR_SECRET=change-me-another-random-secret-at-least-32-bytes
REVIEW_PIPELINE=disabled
# The SAME private server key used by VLLM_API_KEY on RunPod:
A02_QWEN_API_KEY=
