FROM node:22-bookworm-slim AS frontend
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
COPY backend/app/modeltest/prompts.json /build/backend/app/modeltest/prompts.json
RUN npm run build

FROM nginx:1.28-alpine
COPY --from=frontend /build/frontend/dist/ /usr/share/nginx/html/
COPY deploy/agent-framework/aws-nginx.conf.template /etc/nginx/templates/default.conf.template
ENV NGINX_ENVSUBST_FILTER=AF_PUBLIC_HOST
