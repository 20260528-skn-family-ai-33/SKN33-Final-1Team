FROM python:3.12-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /usr/local/bin/uv
ENV PYTHONUNBUFFERED=1 UV_LINK_MODE=copy
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --group dev --no-install-project
COPY backend/ ./backend/
COPY examples/ ./examples/
COPY tests/ ./tests/
COPY scripts/ ./scripts/
COPY docs/poster-baselines/ ./docs/poster-baselines/
ARG TEST_RUN_ID
LABEL io.creativechecker.environment="test" io.creativechecker.test-run=$TEST_RUN_ID
ENTRYPOINT ["/app/.venv/bin/python", "-m", "scripts.framework_graph_test_container"]
