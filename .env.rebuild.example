# Copy to .env.rebuild locally. Do not commit credentials.
DATABASE_URL=postgresql+psycopg://checker:local-development-password@127.0.0.1:25429/checker_rebuild
CC_POSTGRES_PORT=25429
CC_LOCAL_DB_PASSWORD=local-development-password
CC_LOCAL_GRAPH_PASSWORD=local-development-password
CC_DATA_DIR=.runtime/rebuild
CC_STORAGE_BACKEND=local
CC_COOKIE_SECURE=false
CC_NEO4J_URI=bolt://127.0.0.1:57629
CC_NEO4J_USER=neo4j
CC_NEO4J_PASSWORD=local-development-password
CC_MCP_URL=http://127.0.0.1:8129/mcp
CC_MCP_TOKEN=replace-with-a-long-random-token
CC_QWEN_BASE_URL=
CC_QWEN_API_KEY=
CC_QWEN_MODEL=Qwen/Qwen3.5-4B
# Record the official weight revision deployed at the endpoint; this is an operator declaration.
CC_QWEN_REVISION=unverified
CC_S3_BUCKET=
CC_S3_REGION=ap-northeast-2
