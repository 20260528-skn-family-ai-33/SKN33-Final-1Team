# Copy to .env.admin.local or .env.admin.staging. Select only for explicit admin commands.
# Never pass this file to API, worker, MCP or the frontend. Do not commit real values.

# Existing M008 owner/migration/backup profile and initial empty-volume bootstrap.
DB_HOST=127.0.0.1
DB_PORT=5432
POSTGRES_DB=creative_checker
DB_OWNER_USER=creative_checker_owner
DB_OWNER_PASSWORD=change-me-owner-password
DB_APP_USER=creative_checker_app
# The next two secrets are used ONLY by compose.yaml to initialize an EMPTY volume.
POSTGRES_PASSWORD=change-me-admin-password
DB_APP_PASSWORD=change-me-app-password
APP_ENV=development
LOCAL_ADMIN_LOGIN=0
DEV_PROJECT_ID=
IMPORT_ALLOWED_ROOT=/absolute/read-only/snapshots
PG_TOOLS_MODE=docker
PG_TOOLS_IMAGE=postgres:17.11-bookworm
PG_TOOLS_HOST=host.docker.internal
PG_TOOLS_PORT=5432
# Optional setting examples: docs/environment-options.md

# Rebuild bootstrap is a separate DB/schema. Never run M001-M008 against it.
DATABASE_URL=postgresql+psycopg://checker:change-me-rebuild-password@127.0.0.1:25429/checker_rebuild
CC_POSTGRES_PORT=25429
CC_LOCAL_DB_PASSWORD=change-me-rebuild-password
CC_LOCAL_GRAPH_PASSWORD=change-me-graph-password
CC_DATA_DIR=data/creative_checker
CC_STORAGE_BACKEND=local
CC_NEO4J_URI=bolt://127.0.0.1:57629
CC_NEO4J_USER=neo4j
CC_NEO4J_PASSWORD=change-me-graph-password
# Match the corresponding app/DB passwords in the runtime file.
# Changing a file does not rotate credentials already stored in a database volume.
# Backups/restores still require explicit --app-env-file / --worker-env-file inputs.
