<!doctype html>
<html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Creative Checker · 업무와 에이전트 흐름</title>
<style>
:root{--paper:#f4f3ee;--card:#fffef9;--ink:#203d34;--muted:#6b786c;--line:#d8ddd0;--green:#315b48;--soft:#e7eddf;--gold:#a67a3e;--gold-soft:#f7efdc;--mono:ui-monospace,SFMono-Regular,Consolas,monospace;font-family:-apple-system,BlinkMacSystemFont,'Apple SD Gothic Neo','Malgun Gothic',sans-serif;color:var(--ink);background:var(--paper);font-synthesis:none}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:100px}body{margin:0;min-width:1180px;font-size:14px;line-height:1.7}button,input{font:inherit;color:inherit}button{cursor:pointer}button:focus-visible,a:focus-visible,input:focus-visible{outline:3px solid #a07838;outline-offset:4px}a{color:inherit;text-underline-offset:4px}header{height:76px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 40px;gap:30px;background:var(--paper)}.brand{font-weight:750;font-size:18px;text-decoration:none;letter-spacing:-.6px;display:flex;gap:12px;align-items:center}.mark{background:var(--ink);color:var(--paper);width:34px;height:34px;border-radius:50%;font:26px Georgia,serif;text-align:center;line-height:34px}.edition,.eyebrow{font-size:10px;letter-spacing:.18em;text-transform:uppercase;font-weight:700}.edition{color:var(--muted)}header nav{display:flex;gap:23px;font-size:12px}main{max-width:1840px;margin:auto;padding:42px 40px 70px}.hero{display:flex;justify-content:space-between;align-items:end;gap:42px;margin-bottom:28px}.eyebrow{color:var(--green);margin-bottom:12px}h1{font-size:40px;font-weight:680;line-height:1.28;letter-spacing:-1.8px;margin:0 0 16px}h2,h3,p{margin:0}.lead{font-size:14px;color:var(--muted);max-width:780px}.summary{display:flex;gap:34px;flex-shrink:0}.summary strong{font:40px Georgia,serif;display:block;line-height:1.2}.summary span{font-size:11px;color:var(--muted)}.scope{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:26px 0 28px;padding:15px 20px;background:#e8eddf;border:1px solid #d2dcc7;border-radius:9px;font-size:12px}.scope strong{margin-right:10px}.scope .separator{color:#acb9a2}.tabs{display:flex;gap:30px;position:sticky;top:0;background:var(--paper);z-index:20;border-bottom:1px solid #cbd5c5;margin-bottom:25px;min-height:61px;align-items:stretch}.tabs button{border:0;background:none;padding:14px 5px;font-size:14px;color:var(--muted);border-bottom:3px solid transparent;font-weight:600}.tabs button[aria-selected=true]{border-bottom-color:var(--green);color:var(--ink)}.tabs .tab-note{margin-left:auto;align-self:center;font:10px var(--mono);color:var(--muted)}[hidden]{display:none!important}.intro-note{font-size:12px;line-height:1.85;color:var(--muted);margin-bottom:20px;max-width:1080px}.intro-note a{font-weight:600}.toolbar{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:18px}.scenarios{display:flex;padding:4px;background:#e9ede1;border-radius:9px;gap:3px}.scenarios button{border:0;padding:9px 16px;background:transparent;font-size:12px;border-radius:6px}.scenarios button[aria-pressed=true]{background:var(--card);box-shadow:0 1px 5px #2843330d;font-weight:700}.search{display:flex;align-items:center;gap:10px;background:var(--card);border:1px solid var(--line);border-radius:7px;padding:9px 14px}.search input{width:210px;border:0;outline:0;background:none;font-size:12px}.walk{display:flex;align-items:center;gap:12px;font-size:12px}.walk button,.small-button{border:1px solid #c9d5c2;background:var(--card);padding:7px 13px;border-radius:6px;font-size:12px}.walk button:disabled{opacity:.35;cursor:default}.walk output{font:11px var(--mono);min-width:65px;text-align:center}.workspace{display:grid;grid-template-columns:minmax(720px,1fr) 310px;gap:20px;align-items:start}.map-box{border:1px solid #cfd8c7;border-radius:14px;overflow:hidden;background:var(--card)}.orchestrator{background:var(--ink);color:#f4f3ee;padding:20px 25px;display:flex;align-items:center;gap:30px}.orchestrator strong{font-size:17px;white-space:nowrap}.orchestrator p{font-size:12px;color:#cedac9}.orchestrator small{font:10px var(--mono);display:block;color:#afc2a8;letter-spacing:.12em}.legend{padding:15px 25px;border-bottom:1px solid var(--line);display:flex;flex-wrap:wrap;gap:18px;font-size:11px;color:var(--muted)}.legend span{display:flex;align-items:center;gap:6px}.dot{width:7px;height:7px;display:inline-block;background:#7e8e79;border-radius:50%}.dot.partial{background:#315b48}.dot.adapter{background:#a67a3e}.dot.decision{background:#b68c30}.lane-head{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));padding:20px 32px 12px;gap:25px;background:#f8f9f2}.lane-head strong{display:block;font-size:13px}.lane-head small{font:9px var(--mono);letter-spacing:.14em;color:#7b8975}.map-content{position:relative;padding:22px 32px 32px;background-image:radial-gradient(#dce3d4 .7px,transparent .7px);background-size:18px 18px}.map-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px 25px;position:relative;z-index:2;align-items:stretch}.node{display:block;text-align:left;width:100%;min-height:130px;border:1px solid #bfcdb8;border-radius:10px;padding:14px 16px;background:var(--card);box-shadow:0 3px 8px #293f2606;position:relative;transition:border-color .15s,box-shadow .15s,opacity .15s}.node .top{display:flex;gap:8px;justify-content:space-between;align-items:flex-start;margin-bottom:10px}.node .kicker{font:9px var(--mono);line-height:1.55;color:#63785f;max-width:65%}.badge{display:inline-block;white-space:nowrap;font-size:9px;font-weight:700;line-height:1.6;padding:2px 6px;border-radius:4px;background:#eef1e7;color:#687b5f}.badge.partial{color:#315b48;background:#e6efdf}.badge.adapter{color:#8e682f;background:#f3ead7}.badge.decision{color:#805e21;background:#efe0b8}.node h3{font-size:16px;line-height:1.35;font-weight:680;letter-spacing:-.45px;margin-bottom:7px;word-break:keep-all}.node .desc{font-size:11px;color:#6c7868;line-height:1.7;word-break:keep-all}.node[data-lane=human]{background:#fcfaf1;border-color:#cfc5a5}.node[data-lane=evidence]{background:#f1f4eb;border-style:dashed}.node[data-status=decision]{border-left:4px solid #b28b40}.node:hover{box-shadow:0 4px 14px #29443313;border-color:#719269}.node.selected{outline:2px solid #315b48;outline-offset:3px;box-shadow:0 6px 14px #29443318}.node.dim{opacity:.3}.node.on-path .kicker{color:#2c6744}.node.search-match{box-shadow:0 0 0 3px #c9dca6}.connections{position:absolute;inset:0;width:100%;height:100%;z-index:1;pointer-events:none;overflow:visible}.edge{fill:none;stroke:#afbea6;stroke-width:1.4}.edge.evidence{stroke-dasharray:3 4;opacity:.55}.edge.revision{stroke:#b28b40;stroke-dasharray:6 4;stroke-width:1.7}.edge.exception{stroke:#b78067;stroke-dasharray:5 4}.edge.active{stroke:#3b6e46;stroke-width:2.2;opacity:1}.edge.dim{opacity:.15}.edge-label{font-size:10px;fill:#776439;paint-order:stroke;stroke:var(--card);stroke-width:5px;stroke-linejoin:round}.scenario-note{border-top:1px solid var(--line);background:#eef2e5;padding:18px 24px;font-size:12px;line-height:1.8}.inspector{position:sticky;top:82px;max-height:calc(100vh - 104px);overflow:auto;border:1px solid #cfd8c7;border-radius:12px;background:var(--card)}.inspector-head{padding:17px 23px;border-bottom:1px solid var(--line);font:10px var(--mono);letter-spacing:.14em;display:flex;justify-content:space-between;color:#687b62}.inspector-body{padding:24px}.inspector h2{font-size:24px;line-height:1.4;letter-spacing:-.8px;margin:12px 0}.inspector p{font-size:12px;line-height:1.9}.inspector h3{font-size:10px;font-weight:650;letter-spacing:.08em;color:#75846c;margin:0 0 8px}.inspector section{padding:19px 0;border-bottom:1px solid var(--line)}.inspector section:last-child{border-bottom:0}.inspector ul{padding-left:17px;margin:0;font-size:12px;line-height:1.9}.inspector li+li{margin-top:7px}.inspector .current{background:#edf2e4;border-radius:7px;padding:13px 15px;margin:17px 0 2px}.inspector .source-link{display:block;font:10px/1.8 var(--mono);overflow-wrap:anywhere;margin-top:8px;color:#597350}.inspector .next-links{display:flex;gap:7px;flex-wrap:wrap}.inspector .next-links button{font-size:11px;text-align:left;border:1px solid var(--line);background:#f3f5ed;border-radius:5px;padding:6px 9px}.panel-heading{font-size:27px;letter-spacing:-.7px;line-height:1.45;margin-bottom:12px}.panel-lead{font-size:13px;line-height:1.9;color:var(--muted);max-width:950px;margin-bottom:26px}.role-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.role-card,.box{padding:26px;border:1px solid var(--line);border-radius:12px;background:var(--card)}.role-card h3{font-size:20px;margin:10px 0 15px;letter-spacing:-.6px}.role-card p{font-size:12px;line-height:1.9;color:#64765b}.role-card dt{font-size:10px;color:#8a977e;margin:15px 0 5px}.role-card dd{font-size:12px;margin:0}.role-card code{font:11px var(--mono);overflow-wrap:anywhere}.tool-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:17px;margin:24px 0}.tool-strip h3{font-size:15px;margin:8px 0}.tool-strip p{font-size:12px;line-height:1.85;color:var(--muted)}.eyeline{font:10px var(--mono);color:#7c8f70;letter-spacing:.12em}.axis-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;margin-bottom:24px}.axis-grid h3{font-size:20px;margin:8px 0 15px}.axis-grid code{display:inline-block;background:#edf1e5;border-radius:5px;padding:4px 8px;font:11px/1.6 var(--mono);margin:3px 3px 3px 0}.axis-grid p{font-size:12px;color:var(--muted);margin-top:18px;line-height:1.9}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin:24px 0}.version-line{display:flex;align-items:stretch;gap:12px;margin:20px 0}.version-line div{flex:1;padding:17px;background:#eef2e7;border-radius:7px;font-size:12px}.version-line b{display:block;font:18px Georgia,serif;margin-bottom:9px}.version-line span{align-self:center;color:#7d9271}.two-col h3{font-size:19px}.two-col p{font-size:12px;line-height:1.9;color:var(--muted);margin-top:15px}.warning{border-left:3px solid #b18b46;padding:15px 18px;background:#f2ead9;border-radius:0 7px 7px 0;font-size:12px;line-height:1.9}.decisions{width:100%;border-collapse:separate;border-spacing:0;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--card);font-size:12px;table-layout:fixed}.decisions th{background:#e8eede;text-align:left;font-size:11px;padding:16px 19px;color:#526b46}.decisions td{border-top:1px solid var(--line);padding:20px;vertical-align:top;line-height:1.9;word-break:keep-all}.decisions td:first-child{font-weight:650}.source-box{margin-top:24px;padding:25px;border:1px solid var(--line);border-radius:10px;background:#e9eee1;font-size:12px;line-height:1.9;overflow-wrap:anywhere}.source-box code{font:11px var(--mono)}.error{padding:24px;background:#fce9dd;border:1px solid #bc8a6a;border-radius:8px;white-space:pre-wrap}footer{border-top:1px solid var(--line);padding-top:22px;margin-top:35px;display:flex;justify-content:space-between;gap:20px;font-size:11px;color:var(--muted)}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}@media(min-width:1600px){.workspace{grid-template-columns:minmax(920px,1fr) 345px}.node h3{font-size:18px}.node .desc{font-size:12px}.node{padding:17px 20px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}@media print{body{min-width:0;font-size:10px}header,.tabs,.toolbar,.inspector,footer{display:none}main{padding:0}.workspace{display:block}.hero h1{font-size:25px}.hero{margin-bottom:10px}.scope{margin:10px 0}.map-box{overflow:visible}.node{break-inside:avoid}.map-grid{gap:25px 18px}.node h3{font-size:12px}.node .desc{font-size:9px}.node.dim{opacity:1}.map-content{background:none}.connections{print-color-adjust:exact}.summary{display:none}.two-col,.axis-grid,.role-grid{break-inside:avoid}.decisions th,.decisions td{padding:10px}}
</style>
<style id="compact-canvas-ui">
:root{--paper:#f5f5ef;--card:#fffef9;--ink:#172c24;--muted:#66776d;--line:#d8ded3;--green:#245942;--canvas-height:clamp(500px,calc(100vh - 330px),680px)}
body{min-width:1080px;font-size:13px}header{height:68px;padding:0 30px}main{padding:24px 28px 20px;max-width:1920px}.hero{margin-bottom:14px;gap:24px}.hero h1{font-size:31px;line-height:1.2;letter-spacing:-1.4px;margin-bottom:10px}.eyebrow{font-size:10px;margin-bottom:8px}.lead{font-size:13px}.summary{gap:28px}.summary strong{font-size:30px}.summary span{font-size:10px}.scope{margin:14px 0 12px;padding:8px 13px;font-size:10px;gap:10px;background:transparent;border:0;border-bottom:1px solid var(--line);border-radius:0}.scope strong{margin-right:3px}.tabs{position:static;min-height:43px;margin-bottom:14px;gap:23px}.tabs button{font-size:12px;padding:9px 3px}.tabs .tab-note{font-size:9px}.intro-note{font-size:11px;margin-bottom:12px;line-height:1.7}.workspace{grid-template-columns:minmax(0,1fr) 320px;gap:0;align-items:stretch;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:var(--card);box-shadow:0 8px 28px #18362508}.map-box{border:0;border-radius:0;min-width:0;overflow:hidden}.toolbar{padding:14px 16px 10px;margin:0;gap:9px;flex-wrap:wrap}.scenarios{gap:2px;padding:3px}.scenarios button{font-size:11px;padding:7px 10px}.search{padding:7px 9px}.search input{width:145px;font-size:11px}.walk{gap:5px;margin-left:auto}.walk button{padding:5px 9px}.walk output{min-width:58px;font-size:10px}.orchestrator{padding:9px 18px;gap:18px;background:#f0f4e8;color:var(--ink);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.orchestrator strong{font-size:12px}.orchestrator small{display:inline;font-size:9px;margin-right:9px;color:var(--green);letter-spacing:.02em}.orchestrator p{font-size:10px;color:var(--muted);line-height:1.6}.orchestrator br{display:none}.legend{padding:10px 18px;gap:12px;font-size:10px}.legend label{margin-left:auto;display:flex;align-items:center;gap:6px;cursor:pointer}.legend input{accent-color:var(--green);margin:0}.map-content{padding:0;height:var(--canvas-height);min-height:500px;overflow:hidden;touch-action:none;cursor:grab;isolation:isolate;background-color:#f9faf5;background-size:20px 20px}.map-content.dragging{cursor:grabbing}.world{position:absolute;width:1090px;height:900px;transform-origin:0 0;will-change:transform}.map-grid{display:block;position:absolute;inset:0;z-index:2}.connections{width:1090px;height:900px;z-index:1}.world-label{position:absolute;left:30px;font:10px var(--mono);letter-spacing:1.8px;color:#8a978d;pointer-events:none}.world-divider{position:absolute;left:28px;top:615px;width:1030px;border-top:1px dashed #cbd6c7}.node{position:absolute;width:204px;height:104px;min-height:0;padding:13px 15px;display:flex;flex-direction:column;align-items:flex-start;background:var(--card);border:1px solid #cdd9cb;border-radius:10px;box-shadow:0 3px 8px #20382704;user-select:none}.node .top{width:100%;margin-bottom:7px;align-items:center;gap:5px}.node .kicker{font:10px var(--mono);color:var(--green);max-width:none;white-space:nowrap}.node .badge{font-size:8px;padding:0;background:none;font-weight:500}.node h3{font-size:16px;line-height:1.3;letter-spacing:-.6px;margin:0;word-break:keep-all}.node .desc{display:none}.node-kind{font-size:9px;line-height:1.4;color:#73806f;margin-top:6px}.node[data-lane=human]{background:var(--card);border-color:#cdd9cb}.node[data-status=decision]{background:#eef3e4;border:1px solid #c8d3b6;border-radius:20px 6px 20px 6px}.node[data-lane=evidence]{height:84px;background:#f1f4eb;border-style:dashed;box-shadow:none}.node[data-lane=evidence] h3{font-size:14px}.node[data-lane=evidence] .node-kind{display:none}.node.selected{outline:0;border-color:var(--green);box-shadow:0 0 0 2px #24594220,0 6px 14px #2038270a}.node.dim{opacity:.22}.node.search-match{box-shadow:0 0 0 3px #b2bf6a80}.node[data-id=HISTORY]{background:#e6efdf}.node[data-id=FAILED]{background:#f5eee4;border-color:#d8cdbb}.edge{stroke-width:1.7}.edge.active{stroke-width:2.5}.edge.dim{opacity:.08}.edge-label{font-size:10px}.canvas-hint{position:absolute;left:16px;bottom:14px;z-index:5;font-size:10px;color:#758474;background:#f9faf5df;border-radius:5px;padding:6px 8px;pointer-events:none}.zoom-controls{position:absolute;right:14px;bottom:12px;z-index:6;display:flex;align-items:center;gap:1px;border:1px solid var(--line);border-radius:8px;background:var(--card);overflow:hidden;box-shadow:0 3px 10px #18362508}.zoom-controls button{width:34px;height:34px;background:var(--card);border:0;font-size:16px}.zoom-controls button:hover{background:#eef2e7}.zoom-controls output{font:10px var(--mono);min-width:42px;text-align:center}.zoom-controls .fit{font-size:11px;width:46px;border-left:1px solid var(--line)}.scenario-note{font-size:10px;padding:13px 18px;line-height:1.7;min-height:64px}.inspector{position:static;border:0;border-left:1px solid var(--line);border-radius:0;background:#fcfcf7;display:flex;flex-direction:column;max-height:calc(var(--canvas-height) + 245px);overflow:hidden;min-height:0}.inspector-head{flex-shrink:0;padding:17px 21px;font-size:9px}.inspector-body{padding:23px 21px;overflow:auto;min-height:0;flex:1}.inspector h2{font-size:24px}.inspector p,.inspector li{font-size:12px}.inspector .current{padding:11px 13px}.inspector section{padding:16px 0}footer{margin-top:18px;padding-top:14px;font-size:10px}
@media(min-width:1600px){.workspace{grid-template-columns:minmax(0,1fr) 345px}.node{padding:13px 15px}.node h3{font-size:16px}.node .desc{display:none}}
@media print{.toolbar,.orchestrator,.legend,.canvas-hint,.zoom-controls,.inspector{display:none}.workspace{display:block;border:0}.map-content{height:900px;overflow:visible}.world{transform:scale(.85)!important}.node{position:absolute}.node.dim{opacity:1}.node[hidden]{display:block!important}}
</style>
</head><body>
<header><a href="index.html" class="brand"><span class="mark" aria-hidden="true">C</span>Creative Checker</a><span class="edition">Workflow Atlas / 02</span><nav><a href="docs/agent-framework/flow.html">현재 프레임워크 지도 ↗</a><a href="docs/agent-framework/guide.html">개발 안내 ↗</a><a href="docs/reference/creative-checker-master-2026-10-30.html">통합문서 원문 ↗</a></nav></header>
<main><section class="hero"><div><div class="eyebrow">From requirements to a considered approval</div><h1>한눈에 보는 에이전트 플로우.</h1><p class="lead" id="lead">PDF에서 최종 승인까지. 업무 흐름과 각 역할의 연결 지점을 살펴보세요.</p></div><div class="summary"><div><strong>03</strong><span>사람의 승인 지점</span></div><div><strong>07</strong><span>현재 역할 구성</span></div><div><strong id="total-nodes">—</strong><span>업무·근거 노드</span></div></div></section>
<div class="scope"><strong>이번 1차 범위</strong><span>PDF · 포스터</span><span class="separator">/</span><span>Qwen3.5-4B</span><span class="separator">/</span><span>PostgreSQL + Neo4j RAG</span><span class="separator">/</span><span>A04·A05 통합</span><span class="separator">/</span><span>벡터DB · PaddleOCR 제외</span></div>
<div class="tabs" role="tablist" aria-label="흐름도 보기"><button type="button" role="tab" id="tab-flow" aria-selected="true" aria-controls="panel-flow" data-tab="flow">업무 흐름</button><button type="button" role="tab" id="tab-roles" aria-selected="false" aria-controls="panel-roles" data-tab="roles" tabindex="-1">역할과 연결</button><button type="button" role="tab" id="tab-state" aria-selected="false" aria-controls="panel-state" data-tab="state" tabindex="-1">상태와 버전</button><button type="button" role="tab" id="tab-decisions" aria-selected="false" aria-controls="panel-decisions" data-tab="decisions" tabindex="-1">문서 반영 기준</button><span class="tab-note">REFERENCE 2026.10.30 / SCOPE 2026.11.02</span></div>
<div id="error" class="error" role="alert" hidden></div>
<section id="panel-flow" role="tabpanel" aria-labelledby="tab-flow"><p class="intro-note">통합문서의 업무 흐름을 기준으로 구성한 <strong>구현 목표 지도</strong>입니다. 각 노드의 현재 구현 범위는 오른쪽에서 확인하세요. 이 화면의 단계 이동은 설명용이며 API 호출이나 실제 승인을 수행하지 않습니다.</p>
<div class="workspace"><div class="map-box"><div class="toolbar"><div class="scenarios" id="scenarios" role="group" aria-label="흐름 시나리오"></div><div class="walk"><button type="button" id="previous" aria-label="이전 단계">←</button><output id="step-count" aria-live="polite"></output><button type="button" id="next" aria-label="다음 단계">→</button></div><label class="search"><span aria-hidden="true">⌕</span><span class="sr-only">업무 노드 검색</span><input id="search" type="search" placeholder="역할, 업무, 근거 검색" autocomplete="off"></label></div><div class="orchestrator"><strong><small>ORCHESTRATOR · A01</small>전체 흐름 조정</strong><p>접수 · 단계 연결 · 승인 대기 · 실패 처리 · 실행 식별자<br>아래 모든 단계의 공통 기반이며, 별도의 검사 모델을 뜻하지 않습니다.</p></div><div class="legend"><span><i class="dot partial"></i>일부 기반 구현</span><span><i class="dot adapter"></i>실제 어댑터 연결</span><span><i class="dot"></i>제품 연결 목표</span><span><i class="dot decision"></i>사람의 승인 · UI/권한 연결 목표</span><label><input type="checkbox" id="show-evidence">근거 · 예외 펼치기</label></div><div class="map-content" id="map-content" aria-label="빈 곳을 드래그하여 이동하고 확대 버튼으로 그래프를 확대합니다."><div class="world" id="world"><div id="world-labels"></div><svg id="connections" class="connections" aria-hidden="true"><defs><marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0L10 5L0 10Z" fill="#9eaf94"/></marker><marker id="arrow-active" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0L10 5L0 10Z" fill="#3b6e46"/></marker></defs><g id="edges"></g><g id="edge-labels"></g></svg><div class="map-grid" id="map"></div></div><div class="canvas-hint">빈 곳 드래그 · Ctrl / ⌘ + 휠로 확대</div><div class="zoom-controls"><button type="button" id="zoom-out" aria-label="축소">−</button><output id="zoom-level" aria-live="polite"></output><button type="button" id="zoom-in" aria-label="확대">+</button><button type="button" id="fit" class="fit">맞춤</button></div></div><p class="scenario-note" id="scenario-note"></p></div>
<aside class="inspector" aria-label="선택한 업무 설명"><div class="inspector-head"><span>NODE INSPECTOR</span><span id="detail-code"></span></div><div class="inspector-body" id="inspector-body"><span id="detail-badge" class="badge"></span><h2 id="detail-title"></h2><p id="detail-summary"></p><div class="current"><h3>현재 공유 코드 기준</h3><p id="detail-current"></p></div><section><h3>담당</h3><p id="detail-owner"></p></section><section><h3>INPUT / 입력</h3><p id="detail-input"></p><h3 style="margin-top:17px">OUTPUT / 출력</h3><p id="detail-output"></p></section><section><h3>업무에서 확인할 사항</h3><ul id="detail-items"></ul></section><section><h3>통합문서 · 코드 근거</h3><a id="detail-source" class="source-link"></a><div id="detail-files"></div></section><section><h3>연결된 다음 단계</h3><div id="detail-neighbours" class="next-links"></div></section></div></aside></div></section>
<section id="panel-roles" role="tabpanel" aria-labelledby="tab-roles" hidden><h2 class="panel-heading">역할, 도구, 모델은 서로 다릅니다.</h2><p class="panel-lead">A01–A08은 논리적인 책임 구분입니다. 현재 구성에서는 A04와 A05를 하나의 포트로 연결합니다. 역할마다 별도의 LLM이나 서버가 하나씩 필요한 구조가 아닙니다.</p><div id="role-grid" class="role-grid"></div><div class="tool-strip"><div class="box"><div class="eyeline">MODEL</div><h3>Qwen3.5-4B</h3><p>PDF 조건 추출·포스터 관측·보고에 연결할 모델입니다. 현재 합성 예제는 실제 추론을 하지 않습니다.</p></div><div class="box"><div class="eyeline">SOURCE OF TRUTH</div><h3>PostgreSQL</h3><p>문서·기준·산출물 버전과 사람 승인 기록의 원본 저장 목표입니다. 현재 런타임은 메모리 저장입니다.</p></div><div class="box"><div class="eyeline">RELATION RETRIEVAL</div><h3>Neo4j + RAG</h3><p>관계로 근거를 찾아 PostgreSQL 원문·권한·버전을 확인합니다. 벡터 검색 없이 RAG를 유지합니다.</p></div><div class="box"><div class="eyeline">TOOL CONTRACT</div><h3>MCP · 일반 코드</h3><p>MCP는 도구 호출 계약입니다. 모델 자체와 다르며, 스키마·해시·상태 검증은 일반 코드가 담당합니다. 실제 MCP 연결은 후속 범위입니다.</p></div></div><p class="warning">Graphify는 현재 코드의 함수·클래스 관계를 보여줍니다. 이 업무 흐름도 및 실제 실행 모니터와 구분해서 읽어주세요. <a href="docs/agent-framework/graphify-out/graph.html">Graphify 코드 지도 열기 ↗</a></p></section>
<section id="panel-state" role="tabpanel" aria-labelledby="tab-state" hidden><h2 class="panel-heading">실행, 판정, 승인을 따로 읽습니다.</h2><p class="panel-lead">모델 실행 오류는 창작물의 불합격이 아니고, 자동 검사 통과는 사람의 최종 승인이 아닙니다. 아래는 공유 폴더의 공통 런타임이 사용하는 세 축입니다.</p><div class="axis-grid"><div class="box"><div class="eyeline">EXECUTION STATUS</div><h3>어디까지 진행됐나요?</h3><code>waiting_criteria</code><code>waiting_review</code><code>waiting_revision</code><code>completed</code><code>failed</code><code>outcome_unknown</code><p>현재 개발 런타임은 사람의 대기 상태까지 표현합니다. 문서의 queued/running·영속 worker·재시도 attempt는 제품 실행기 연결 목표입니다.</p></div><div class="box"><div class="eyeline">MACHINE VERDICT</div><h3>조건을 충족했나요?</h3><code>pass</code><code>fail</code><code>review</code><p>근거 부족·미지원·미관측을 통과로 바꾸지 않습니다. 실행 실패는 별도로 남기며, 일부 단계 결과가 있어도 전체 검사 완료로 읽지 않습니다.</p></div><div class="box"><div class="eyeline">HUMAN DECISION</div><h3>사람이 무엇을 결정했나요?</h3><code>unreviewed</code><code>changes_approved</code><code>final_approved</code><code>exception_approved</code><p>최종 승인은 특정 기준·산출물 버전에만 적용합니다. 예외 승인에도 사유와 대상 조건이 필요하며 기계 판정을 바꾸지 않습니다.</p></div></div><div class="two-col"><div class="box"><h3>수정본은 새로운 실행입니다.</h3><div class="version-line"><div><b>run #1</b>기준 vN<br>산출물 v1</div><span>→</span><div><b>수정 요청</b>사람 확정<br>새 버전 제출</div><span>→</span><div><b>run #2</b>기준 vN<br>산출물 v2</div></div><p>부모 실행·수정 요청과 연결하고 조건 전체를 다시 검사합니다. 현재 프레임워크는 초안을 재사용한 새 실행에서 기준 승인을 다시 받습니다. 문서의 ‘같은 승인 기준으로 검사부터 반복’과 차이가 있어 정책을 명시해야 합니다.</p></div><div class="box"><h3>실패와 확인 필요도 다릅니다.</h3><p><strong>근거 검색 unavailable:</strong> 정상 계약으로 반환되면 확인 필요(review) 보고와 사람 검토로 이어질 수 있습니다.</p><p><strong>호출 예외·결과 불명:</strong> failed/outcome_unknown으로 남깁니다. 현재 코드에는 자동 재시도가 없고, 문서의 재시도 횟수·취소·복구 정책은 확정된 운영 구현이 아닙니다.</p><p><strong>비교 화면:</strong> 새 검수 결과를 이전 결과와 비교해야 합니다. ‘수정 완료’ 클릭 자체가 요청 해결이나 최종 승인의 증거가 되지 않습니다.</p></div></div><p class="warning">승인 권한·영속 이력·원문 파일 검증은 제품 통합 대상입니다. 지금 보이는 설명 그래프나 합성 demo가 이를 구현·배포했다는 뜻은 아닙니다.</p></section>
<section id="panel-decisions" role="tabpanel" aria-labelledby="tab-decisions" hidden><h2 class="panel-heading">문서의 맥락을 반영하고, 변경된 범위를 구분합니다.</h2><p class="panel-lead">참조 문서는 2026년 10월 30일 팀 검토용 초안입니다. 업무 단계와 승인·버전 원칙을 가져오고, 이후 이 대화에서 정한 1차 범위는 유지했습니다. 현재 공유 코드와 다른 정책은 아래에 그대로 드러냅니다.</p><table class="decisions"><thead><tr><th style="width:15%">항목</th><th style="width:28%">통합문서의 설명</th><th style="width:28%">현재 결정·공유 코드</th><th style="width:29%">이번 화면 반영</th></tr></thead><tbody id="decisions"></tbody></table><div class="source-box"><strong>참조 원문</strong><p id="source-title"></p><p><a href="docs/reference/creative-checker-master-2026-10-30.html">공유 폴더에 포함된 원문 열기 ↗</a> · <a href="docs/planning/pdf-qwen-rag-workflow-plan-2026-11-02.html">PDF·Qwen·RAG 상세 계획 ↗</a></p><p>원문 SHA-256 <code id="source-hash"></code></p><p id="basis"></p></div></section>
<footer><p>설명용 업무 지도 · 실제 모델 실행·사용자 승인·배포 완료의 증거가 아닙니다.</p><p>Desktop · Offline HTML · 상대 경로 · macOS / Windows</p></footer><p class="sr-only" role="status" id="announcement"></p></main>
<script type="application/json" id="business-data">__BUSINESS_DATA__</script>
<script>
(() => {'use strict';const $=id=>document.getElementById(id);try{
const data=JSON.parse($('business-data').textContent),byId=new Map(data.nodes.map(n=>[n.id,n])),nodeEls=new Map();
const labels={target:'제품 연결 목표',partial:'일부 기반 구현',adapter:'어댑터 연결',decision:'사람 승인'};
const positions={UPLOAD:[30,45],EXTRACT:[285,45],CRITERIA_APPROVAL:[540,45],FREEZE:[795,45],RETRIEVE:[795,185],INSPECT:[540,185],VALIDATE:[285,185],REPORT:[30,185],RESULT_REVIEW:[30,325],COMPARE:[285,325],FINAL_APPROVAL:[540,325],HISTORY:[795,325],CHANGE_APPROVAL:[30,465],NEW_ASSET:[285,465],REREVIEW:[540,465],FILES:[30,650],APPROVED:[285,650],OBSERVATIONS:[540,650],NEEDS_REVIEW:[795,650],FAILED:[30,770],CHANGE_DETAILS:[285,770],FINAL_RECORD:[540,770]};
const shortTitles={UPLOAD:'프로젝트 · 자료 제출',EXTRACT:'PDF 조건 초안',CRITERIA_APPROVAL:'기준 확정',FREEZE:'실행 입력 고정',RETRIEVE:'근거 검색 · RAG',INSPECT:'텍스트·시각 검사',VALIDATE:'근거·판정 검증',REPORT:'결과 · 수정 초안',RESULT_REVIEW:'검수 결과 확인',COMPARE:'수정 전후 비교',FINAL_APPROVAL:'최종·예외 승인',HISTORY:'버전 · 승인 이력',CHANGE_APPROVAL:'수정 요청 확정',NEW_ASSET:'수정본 재제출',REREVIEW:'전체 재검수 연결',FILES:'원본 · 파일 정보',APPROVED:'승인 기준 스냅샷',OBSERVATIONS:'관측 · 이미지 근거',NEEDS_REVIEW:'근거 부족 · 확인 필요',FAILED:'실행 실패 · 결과 불명',CHANGE_DETAILS:'수정 요청 정보',FINAL_RECORD:'승인 대상 · 원판정'};
const codes={UPLOAD:'INPUT',EXTRACT:'A02',CRITERIA_APPROVAL:'HUMAN 01',FREEZE:'RUN CONTEXT',RETRIEVE:'A03',INSPECT:'A04 · A05',VALIDATE:'A06',REPORT:'A07',RESULT_REVIEW:'REVIEW',COMPARE:'COMPARE',FINAL_APPROVAL:'HUMAN 03',HISTORY:'HISTORY',CHANGE_APPROVAL:'HUMAN 02',NEW_ASSET:'NEW VERSION',REREVIEW:'A08',FILES:'SOURCE',APPROVED:'CRITERIA',OBSERVATIONS:'EVIDENCE',NEEDS_REVIEW:'REVIEW',FAILED:'ERROR',CHANGE_DETAILS:'CHANGE REQUEST',FINAL_RECORD:'APPROVAL'};
let scenario='overview',step=0,selected=data.scenarios.overview.path[0],query='',showEvidence=false,scale=1,tx=0,ty=0,drag=null;
function el(tag,text,cls){const e=document.createElement(tag);e.textContent=text;if(cls)e.className=cls;return e;}
function isVisible(n){return n.lane!=='evidence'||showEvidence;}
function searchableText(n){return [n.title,n.kicker,n.summary,n.owner,n.input,n.output,n.current,...n.details].join(' ').toLowerCase();}
function applyTransform(){$('world').style.transform=`translate(${tx}px,${ty}px) scale(${scale})`;$('zoom-level').value=Math.round(scale*100)+'%';}
function fit(){if($('panel-flow').hidden)return;const c=$('map-content'),height=showEvidence?900:610;scale=Math.max(.25,Math.min((c.clientWidth-24)/1090,(c.clientHeight-24)/height,1.15));tx=(c.clientWidth-1090*scale)/2;ty=(c.clientHeight-height*scale)/2;applyTransform();}
function zoom(factor,cx=$('map-content').clientWidth/2,cy=$('map-content').clientHeight/2){const next=Math.max(.25,Math.min(1.8,scale*factor));tx=cx-(cx-tx)*next/scale;ty=cy-(cy-ty)*next/scale;scale=next;applyTransform();}
function focusNode(id){const n=byId.get(id),[x,y]=positions[id],height=n.lane==='evidence'?84:104,c=$('map-content');if(tx+x*scale<18||tx+(x+204)*scale>c.clientWidth-18)tx=c.clientWidth/2-(x+102)*scale;if(ty+y*scale<18||ty+(y+height)*scale>c.clientHeight-55)ty=c.clientHeight/2-(y+height/2)*scale;applyTransform();}
for(const [title,y] of [['01 / REQUIREMENTS',17],['02 / REVIEW & EVIDENCE',157],['03 / RESULTS & APPROVAL',297],['04 / REVISION',437]]){const label=el('div',title,'world-label');label.style.top=y+'px';$('world-labels').append(label);}
const trayLabel=el('div','EVIDENCE & EXCEPTIONS / 상세 근거','world-label');trayLabel.style.top='625px';const divider=el('div','','world-divider');$('world-labels').append(divider,trayLabel);
function sourceHref(source){return 'docs/reference/creative-checker-master-2026-10-30.html#'+encodeURIComponent(source.anchor);}
data.nodes.forEach(n=>{const b=document.createElement('button');b.type='button';b.className='node';b.dataset.id=n.id;b.dataset.lane=n.lane;b.dataset.status=n.status;b.style.left=positions[n.id][0]+'px';b.style.top=positions[n.id][1]+'px';b.setAttribute('aria-pressed','false');b.setAttribute('aria-label',n.title+' · '+labels[n.status]);const top=el('span','','top');top.append(el('span',codes[n.id],'kicker'),el('span',{partial:'기반 있음',adapter:'연결 필요',target:'목표',decision:'사람 승인'}[n.status],'badge '+n.status));b.append(top,el('h3',shortTitles[n.id]),el('span',{human:'HUMAN',system:'AGENT / SYSTEM',evidence:'EVIDENCE'}[n.lane],'node-kind'));b.addEventListener('click',()=>select(n.id));b.addEventListener('focus',()=>focusNode(n.id));$('map').append(b);nodeEls.set(n.id,b);});
function draw(){if($('panel-flow').hidden)return;$('connections').setAttribute('viewBox','0 0 1090 900');$('edges').replaceChildren();$('edge-labels').replaceChildren();const path=data.scenarios[scenario].path,pairs=new Set(path.slice(1).map((id,i)=>path[i]+'>'+id));data.edges.forEach(e=>{const a=byId.get(e.from),b=byId.get(e.to),near=e.from===selected||e.to===selected;if(!isVisible(a)||!isVisible(b)||(e.kind==='evidence'&&!near))return;const [ax,ay]=positions[a.id],[bx,by]=positions[b.id],ah=a.lane==='evidence'?84:104,bh=b.lane==='evidence'?84:104;let d,lx,ly,rotate=false;
if(by<ay){const gutter=1050;d=a.lane==='evidence'?`M${ax+102} ${ay} V${ay-18} H${gutter} V${by-18} H${bx+102} V${by}`:`M${ax+204} ${ay+ah/2} H${gutter} V17 H${bx+102} V${by}`;lx=gutter-10;ly=(ay+by)/2;rotate=true;}
else if(ay===by&&Math.abs(bx-ax)>260){const y=ay-17;d=`M${ax+102} ${ay} V${y} H${bx+102} V${by}`;lx=(ax+bx)/2+102;ly=y-6;}
else if(ay===by){const right=bx>ax,x1=ax+(right?204:0),x2=bx+(right?0:204);d=`M${x1} ${ay+ah/2} L${x2} ${by+bh/2}`;lx=(x1+x2)/2;ly=ay-7;}
else{const x1=ax+102,y1=ay+ah,x2=bx+102,y2=by,mid=(y1+y2)/2;d=`M${x1} ${y1} C${x1} ${mid},${x2} ${mid},${x2} ${y2}`;lx=(x1+x2)/2+8;ly=mid-3;}
const active=pairs.has(e.from+'>'+e.to),p=document.createElementNS('http://www.w3.org/2000/svg','path');p.setAttribute('d',d);p.setAttribute('class','edge '+e.kind+(active?' active':'')+(!active&&!near?' dim':''));p.setAttribute('marker-end',active?'url(#arrow-active)':'url(#arrow)');$('edges').append(p);if(e.label&&near){const label=document.createElementNS('http://www.w3.org/2000/svg','text');label.setAttribute('x',lx);label.setAttribute('y',ly);label.setAttribute('text-anchor','middle');label.setAttribute('class','edge-label');if(rotate)label.setAttribute('transform',`rotate(-90 ${lx} ${ly})`);label.textContent=e.label;$('edge-labels').append(label);}});}
function redraw(){const path=data.scenarios[scenario].path;for(const n of data.nodes){const b=nodeEls.get(n.id),match=!query||searchableText(n).includes(query);b.hidden=!isVisible(n);b.classList.toggle('selected',n.id===selected);b.classList.toggle('on-path',path.includes(n.id));b.classList.toggle('dim',query?!match:(!path.includes(n.id)&&n.id!==selected));b.classList.toggle('search-match',Boolean(query&&match));b.setAttribute('aria-pressed',String(n.id===selected));}trayLabel.hidden=divider.hidden=!showEvidence;document.querySelectorAll('[data-scenario]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.scenario===scenario)));$('scenario-note').textContent=data.scenarios[scenario].note;const onPath=path.includes(selected);$('step-count').textContent=onPath?String(step+1).padStart(2,'0')+' / '+String(path.length).padStart(2,'0'):'경로 외 탐색';$('previous').disabled=!onPath||step===0;$('next').disabled=!onPath||step===path.length-1;draw();}
function selectionStep(path,id,current){const indices=path.flatMap((value,index)=>value===id?[index]:[]);return indices.find(index=>index>=current)??indices[0]??current;}
function select(id,center=false){const n=byId.get(id);if(!n)return;if(n.lane==='evidence'&&!showEvidence){showEvidence=true;$('show-evidence').checked=true;}step=selectionStep(data.scenarios[scenario].path,id,step);selected=id;$('inspector-body').scrollTop=0;$('detail-code').textContent=n.kicker;$('detail-title').textContent=n.title;$('detail-summary').textContent=n.summary;$('detail-badge').className='badge '+n.status;$('detail-badge').textContent=labels[n.status];$('detail-current').textContent=n.current;$('detail-owner').textContent=n.owner;$('detail-input').textContent=n.input;$('detail-output').textContent=n.output;$('detail-items').replaceChildren(...n.details.map(t=>el('li',t)));$('detail-source').textContent='통합문서 · '+n.source.section+' ↗';$('detail-source').href=sourceHref(n.source);$('detail-files').replaceChildren(...n.codeRefs.map(f=>{const a=el('a',f.path+' : '+f.line,'source-link');a.href='docs/agent-framework/source.html?file='+encodeURIComponent(f.path)+'#L'+f.line;return a;}));$('detail-neighbours').replaceChildren(...data.edges.filter(e=>e.from===id).map(e=>{const b=el('button',byId.get(e.to).title+' ↗');b.type='button';b.addEventListener('click',()=>{select(e.to,true);});return b;}));$('announcement').textContent=n.title+' 선택. '+n.current;redraw();if(center)focusNode(id);}
function move(delta){step=Math.max(0,Math.min(data.scenarios[scenario].path.length-1,step+delta));const id=data.scenarios[scenario].path[step];select(id,true);}
for(const [key,value] of Object.entries(data.scenarios)){const b=el('button',value.label);b.type='button';b.dataset.scenario=key;b.addEventListener('click',()=>{scenario=key;step=0;select(value.path[0],true);});$('scenarios').append(b);}
$('previous').addEventListener('click',()=>move(-1));$('next').addEventListener('click',()=>move(1));$('search').addEventListener('input',e=>{query=e.target.value.trim().toLowerCase();if(query&&!showEvidence&&data.nodes.some(n=>n.lane==='evidence'&&searchableText(n).includes(query))){showEvidence=true;$('show-evidence').checked=true;fit();}redraw();});
const tabs=Array.from(document.querySelectorAll('[data-tab]'));function setTab(name){for(const b of tabs){const active=b.dataset.tab===name;b.setAttribute('aria-selected',String(active));b.tabIndex=active?0:-1;$('panel-'+b.dataset.tab).hidden=!active;}if(name==='flow')requestAnimationFrame(()=>{fit();draw();});}
tabs.forEach((b,i)=>{b.addEventListener('click',()=>setTab(b.dataset.tab));b.addEventListener('keydown',e=>{let n;if(e.key==='ArrowRight')n=(i+1)%tabs.length;else if(e.key==='ArrowLeft')n=(i+tabs.length-1)%tabs.length;else if(e.key==='Home')n=0;else if(e.key==='End')n=tabs.length-1;else return;e.preventDefault();setTab(tabs[n].dataset.tab);tabs[n].focus();});});
for(const r of data.roles){const card=el('article','','role-card');card.append(el('div',r.id,'eyeline'),el('h3',r.title),el('p',r.responsibility));const dl=document.createElement('dl');for(const [name,value] of [['연결 포트',r.port],['현재 구현',r.current],['연결할 기능',r.target]]){dl.append(el('dt',name),el('dd',value));}card.append(dl);$('role-grid').append(card);}
for(const item of data.decisions){const row=document.createElement('tr');for(const key of ['topic','reference','current','resolution'])row.append(el('td',item[key]));const a=el('a','문서 '+item.section+' ↗');a.href=sourceHref(item);row.lastChild.append(document.createElement('br'),a);$('decisions').append(row);}
$('total-nodes').textContent=data.nodes.length;$('source-title').textContent=data.meta.sourceTitle;$('source-hash').textContent=data.meta.sourceSha256;$('basis').textContent=data.meta.basis+' · '+data.meta.implementationNote;$('show-evidence').addEventListener('change',e=>{showEvidence=e.target.checked;if(!showEvidence&&byId.get(selected).lane==='evidence')select(data.scenarios[scenario].path[0]);redraw();fit();});
$('zoom-in').addEventListener('click',()=>zoom(1.15));$('zoom-out').addEventListener('click',()=>zoom(1/1.15));$('fit').addEventListener('click',fit);
const canvas=$('map-content');canvas.addEventListener('pointerdown',e=>{if(e.button!==0||e.target.closest('button,input,a'))return;drag={x:e.clientX,y:e.clientY,tx,ty};canvas.setPointerCapture(e.pointerId);canvas.classList.add('dragging');});
canvas.addEventListener('pointermove',e=>{if(!drag)return;tx=drag.tx+e.clientX-drag.x;ty=drag.ty+e.clientY-drag.y;applyTransform();});function endDrag(){drag=null;canvas.classList.remove('dragging');}canvas.addEventListener('pointerup',endDrag);canvas.addEventListener('pointercancel',endDrag);
canvas.addEventListener('wheel',e=>{if(e.ctrlKey||e.metaKey){e.preventDefault();const r=canvas.getBoundingClientRect();zoom(e.deltaY<0?1.05:1/1.05,e.clientX-r.left,e.clientY-r.top);}}, {passive:false});new ResizeObserver(fit).observe(canvas);select(selected);requestAnimationFrame(fit);
}catch(error){$('error').hidden=false;$('error').textContent='흐름 자료를 읽지 못했습니다. 생성된 index.html을 확인해 주세요.\n'+error.message;}})();
</script></body></html>
