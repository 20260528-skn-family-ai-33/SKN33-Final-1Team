<!doctype html>
<!-- Build input only. Open docs/agent-framework/flow.html for the completed page. -->
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light">
<title>Creative Checker · Agent Flow</title>
<style>
:root{--paper:#f5f5ef;--white:#fffef9;--ink:#172c24;--muted:#66776d;--line:#d8ded3;--green:#245942;--lime:#e3ecc2;--amber:#865b2b;--purple:#72577d;--shadow:0 8px 28px #18362508;font-family:-apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo","Malgun Gothic",sans-serif;color:var(--ink);background:var(--paper)}
*{box-sizing:border-box}body{margin:0;min-width:1080px}button,input,a{font:inherit}button,a,input{outline-offset:4px}button{cursor:pointer}button:disabled{cursor:default;opacity:.4}a{color:inherit;text-underline-offset:4px}button{color:inherit}button:focus-visible,a:focus-visible,input:focus-visible{outline:3px solid #77994b}button{border:0}header{height:76px;display:flex;align-items:center;justify-content:space-between;padding:0 32px;border-bottom:1px solid var(--line);gap:24px}.brand{display:flex;align-items:center;gap:12px;text-decoration:none;font-weight:760;font-size:17px;letter-spacing:-.4px}.brand-mark{display:grid;place-items:center;width:34px;height:34px;background:var(--ink);color:var(--paper);border-radius:50%;font-family:Georgia,serif;font-size:24px}.header-links{display:flex;align-items:center;gap:24px;font-size:12px}.edition{font:11px ui-monospace,SFMono-Regular,Consolas,monospace;letter-spacing:1.8px;color:var(--muted)}main{padding:28px 28px 20px;max-width:1920px;margin:auto}.intro{display:flex;justify-content:space-between;gap:24px;align-items:flex-end;margin:0 4px 24px}.eyebrow{font-size:10px;letter-spacing:2.1px;color:var(--green);font-weight:800;text-transform:uppercase;margin-bottom:9px}h1{font-size:31px;font-weight:650;letter-spacing:-1.7px;margin:0 0 10px;line-height:1.2}.subtitle{margin:0;color:var(--muted);font-size:13px;line-height:1.7}.summary-counts{display:flex;gap:28px;padding-bottom:4px;white-space:nowrap}.summary-counts strong{display:block;font:30px Georgia,serif;letter-spacing:-1px}.summary-counts span{font-size:10px;letter-spacing:.5px;color:var(--muted)}.workspace{display:grid;grid-template-columns:minmax(0,1fr) 320px;border:1px solid var(--line);border-radius:16px;background:var(--white);overflow:hidden;box-shadow:var(--shadow)}.map-column{min-width:0;border-right:1px solid var(--line)}.map-top{display:flex;align-items:center;justify-content:space-between;padding:16px 18px 12px;gap:12px}.tabs{display:flex;gap:4px;background:#edf0e6;padding:4px;border-radius:8px}.tabs button{font-size:12px;background:transparent;padding:8px 12px;border-radius:5px;color:var(--muted);white-space:nowrap}.tabs button[aria-pressed=true]{background:var(--white);color:var(--ink);box-shadow:0 1px 4px #26342612}.search{display:flex;align-items:center;gap:7px;border:1px solid var(--line);border-radius:7px;max-width:215px;padding:8px 10px;color:var(--muted);background:var(--white)}.search span{font-size:15px}.search input{width:100%;border:0;outline:none;background:transparent;font-size:12px;min-width:0;color:var(--ink)}.filters{display:flex;align-items:center;gap:16px;padding:0 20px 12px;flex-wrap:wrap;border-bottom:1px solid var(--line);font-size:11px;color:var(--muted)}.filters label{display:flex;align-items:center;gap:6px;cursor:pointer}.filters input{accent-color:var(--green);margin:0}.filters .note{margin-left:auto;color:var(--muted)}.dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--green);margin-right:5px}.dot.adapter{background:#ad8451}.dot.planned{background:#a5afa6}.canvas{height:720px;min-height:550px;position:relative;overflow:hidden;touch-action:none;background-color:#f9faf5;background-image:radial-gradient(#cdd6c9 1px,transparent 1px);background-size:20px 20px;cursor:grab;isolation:isolate}.canvas.dragging{cursor:grabbing}.world{position:absolute;width:1090px;height:900px;transform-origin:0 0;will-change:transform}.connections{position:absolute;inset:0;width:1090px;height:900px;overflow:visible;pointer-events:none}.connection{fill:none;stroke:#a6b6a6;stroke-width:1.7;opacity:.72}.connection.revision{stroke:var(--purple);stroke-dasharray:6 5}.connection.dependency{stroke:#a8b5ac;stroke-dasharray:3 5;opacity:.2}.connection.active{stroke:var(--green);stroke-width:2.8;opacity:1}.connection.active.revision{stroke:var(--purple)}.connection.dim{opacity:.07}.edge-label{font-size:11px;fill:#6f8172;paint-order:stroke;stroke:#f9faf5;stroke-width:6px;stroke-linejoin:round}.edge-label.revision{fill:var(--purple)}.lane-label{position:absolute;left:30px;color:#8a978d;font:10px ui-monospace,SFMono-Regular,Consolas,monospace;letter-spacing:2px;pointer-events:none}.lane-divider{position:absolute;top:744px;left:28px;width:1035px;border-top:1px dashed #cbd6c7}.node{position:absolute;display:flex;flex-direction:column;align-items:flex-start;text-align:left;width:204px;height:112px;padding:15px 16px;background:var(--white);border:1px solid #cdd9cb;border-radius:10px;box-shadow:0 3px 8px #20382704;transition:box-shadow .16s,border-color .16s,opacity .16s}.node:hover{border-color:#779776;box-shadow:0 5px 15px #20382712}.node.selected{border-color:var(--green);box-shadow:0 0 0 2px #24594220,0 6px 14px #2038270a}.node.approval{background:#eef3e4;border-color:#c8d3b6;border-radius:20px 6px 20px 6px}.node.dependency{height:92px;background:#f4f5ef;border-style:dashed;border-color:#b8c5b5;box-shadow:none}.node.output{background:#e6efdf}.node.dim{opacity:.22}.node.search-match{box-shadow:0 0 0 3px #b2bf6a80}.node .node-top{display:flex;align-items:center;justify-content:space-between;width:100%;gap:8px;margin-bottom:9px}.node-code{font:11px ui-monospace,SFMono-Regular,Consolas,monospace;letter-spacing:.8px;color:var(--green)}.node-state{font-size:9px;color:var(--muted);white-space:nowrap}.node-state.adapter{color:var(--amber)}.node-state.planned{color:#788478}.node-name{font-size:17px;font-weight:650;letter-spacing:-.6px;line-height:1.25;white-space:nowrap}.node-kind{font-size:10px;margin-top:7px;color:#73806f;white-space:nowrap}.node.step-on:before{content:"";position:absolute;inset:-6px;border:1px solid #759648;border-radius:inherit;pointer-events:none}.canvas-hint{position:absolute;left:18px;bottom:16px;font-size:10px;color:#758474;background:#f9faf5df;padding:7px 9px;border-radius:5px;pointer-events:none}.zoom-controls{position:absolute;right:16px;bottom:14px;display:flex;align-items:center;gap:1px;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:var(--white);box-shadow:var(--shadow)}.zoom-controls button{width:34px;height:34px;background:var(--white);font-size:16px}.zoom-controls button:hover{background:#eef2e7}.zoom-controls output{font:10px ui-monospace,monospace;min-width:42px;text-align:center;color:var(--muted)}.zoom-controls .fit{font-size:11px;width:46px;border-left:1px solid var(--line)}.map-bottom{min-height:76px;padding:15px 18px;display:flex;align-items:center;gap:14px;border-top:1px solid var(--line)}.step-count{font:11px ui-monospace,monospace;color:var(--green);white-space:nowrap}.step-text{flex:1;min-width:0}.step-text strong{display:block;font-size:12px;margin-bottom:4px}.step-text span{display:block;font-size:10px;color:var(--muted);line-height:1.5}.step-controls{display:flex;gap:6px}.small-button{padding:9px 11px;border:1px solid var(--line);border-radius:6px;background:var(--white);font-size:11px;white-space:nowrap}.primary-button{background:var(--ink);color:var(--white);border-color:var(--ink)}.detail{background:#fcfcf7;min-width:0;display:flex;flex-direction:column;max-height:890px}.detail-head{display:flex;align-items:center;justify-content:space-between;padding:19px 22px;border-bottom:1px solid var(--line);font-size:10px;letter-spacing:1.5px;color:var(--muted)}.detail-body{padding:25px 22px;overflow:auto;flex:1}.detail-code{font:12px ui-monospace,monospace;color:var(--green);margin-bottom:10px}h2{font-size:25px;letter-spacing:-1px;margin:0 0 12px;line-height:1.3}.detail-summary{font-size:13px;line-height:1.8;color:#52695a;margin:0 0 19px}.detail-status{display:inline-flex;gap:6px;align-items:center;padding:6px 8px;border-radius:4px;background:var(--lime);font-size:10px}.detail-status.adapter{background:#f0e7d7;color:var(--amber)}.detail-status.planned{background:#e9ede6;color:var(--muted)}.detail-section{margin-top:24px;padding-top:19px;border-top:1px solid var(--line)}.detail-section h3{font-size:10px;letter-spacing:1px;color:var(--muted);margin:0 0 12px;font-weight:600}.detail-section p,.detail-section li{font-size:12px;line-height:1.9;margin:0;overflow-wrap:anywhere}.detail-section ul{padding-left:16px;margin:0}.io-label{font-size:9px;letter-spacing:1px;margin:10px 0 4px;color:var(--muted)}.contract{font:11px ui-monospace,SFMono-Regular,Consolas,monospace;line-height:1.7;overflow-wrap:anywhere}.source-link{font:10px ui-monospace,monospace;line-height:1.7;display:block;margin-bottom:6px;color:var(--green);overflow-wrap:anywhere}.neighbours{display:flex;gap:6px;flex-wrap:wrap}.neighbours button{background:#eaf0e3;color:var(--green);font-size:10px;padding:7px 8px;border-radius:5px;text-align:left}.detail-footer{padding:15px 22px;border-top:1px solid var(--line);font-size:10px;color:var(--muted);line-height:1.7;background:#f3f5ed}.bottom-note{display:flex;justify-content:space-between;gap:24px;margin:17px 4px 0;font-size:10px;color:var(--muted);line-height:1.8}.bottom-note p{margin:0}.source-note{max-width:790px}.code-map{display:flex;gap:24px;align-items:center;margin-top:22px;padding:22px 26px;background:var(--ink);color:var(--white);border-radius:12px}.code-map-title{font:18px Georgia,serif;letter-spacing:-.3px;white-space:nowrap}.code-map p{font-size:11px;line-height:1.8;color:#c4d1bf;margin:0;flex:1}.code-map a{font-size:11px;white-space:nowrap;text-decoration:none;border:1px solid #617a63;padding:10px 13px;border-radius:6px}.code-map small{display:block;margin-top:5px;color:#9fb09e;font-size:9px}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}.error-banner{padding:20px;border:1px solid #c48d76;background:#fff0e8;white-space:pre-wrap}.hidden{display:none!important}@media(min-width:1600px){.canvas{height:800px}.workspace{grid-template-columns:minmax(0,1fr) 355px}.detail{max-height:970px}}@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}@media print{body{min-width:0;background:white}header,.map-top,.filters,.map-bottom,.zoom-controls,.canvas-hint,.detail,.code-map,.bottom-note{display:none}.workspace{display:block;border:0;box-shadow:none}.map-column{border:0}.canvas{height:900px;background:none;overflow:visible}.world{transform:scale(.9)!important}.intro{margin-bottom:10px}main{padding:0}.summary-counts{display:none}.node.dim{opacity:1}.connection.dim{opacity:.6}}
</style>
<style>
.node .node-name{font-size:16px;white-space:normal;word-break:keep-all;line-height:1.3}.node .node-code{font-size:10px}.node .node-top{margin-bottom:7px}.node .node-kind{margin-top:5px}.node.dependency .node-kind{display:none}.detail-code{overflow-wrap:anywhere;line-height:1.6}.node[data-id="FAILURE"]{background:#f5eee4;border-color:#d8cdbb}
</style>
</head>
<body>
<header>
  <a class="brand" href="index.html"><span class="brand-mark" aria-hidden="true">C</span>Creative Checker</a>
  <div class="edition">FRAMEWORK ATLAS / 01</div>
  <nav class="header-links" aria-label="문서 링크"><a href="../../index.html">통합 업무 흐름 ↗</a><a href="guide.html">개발 가이드 ↗</a><a href="../planning/pdf-qwen-rag-workflow-plan-2026-11-02.html">전체 계획 ↗</a></nav>
</header>
<main>
  <section class="intro">
    <div><div class="eyebrow">A shared map for independent development</div><h1>현재 공통 프레임워크 지도.</h1><p class="subtitle">공유 폴더에 포함된 개발 코드의 연결 지점입니다. 전체 업무 목표는 통합문서 기반 흐름에서 확인하세요.</p></div>
    <div class="summary-counts"><div><strong>07</strong><span>에이전트 역할</span></div><div><strong>03</strong><span>사람의 승인 지점</span></div><div><strong id="node-count">—</strong><span>흐름 노드</span></div></div>
  </section>
  <div id="load-error" class="error-banner hidden" role="alert"></div>
  <div class="workspace">
    <section class="map-column" aria-label="업무 흐름 그래프">
      <div class="map-top"><div class="tabs" role="group" aria-label="설명 시나리오"><button type="button" data-scenario="pass" aria-pressed="true">기본 검수</button><button type="button" data-scenario="revision" aria-pressed="false">수정 · 재검수</button><button type="button" data-scenario="unavailable" aria-pressed="false">검색 장애</button></div><label class="search"><span aria-hidden="true">⌕</span><span class="sr-only">노드 검색</span><input id="search" type="search" placeholder="역할, 계약, 파일 검색" autocomplete="off"></label></div>
      <div class="filters"><span><i class="dot"></i>공통 기반 구현</span><span><i class="dot adapter"></i>실제 구현 연결 자리</span><label><input type="checkbox" id="show-dependencies" checked><span><i class="dot planned"></i>연결할 외부 기능</span></label><span class="note" id="filter-note">노드를 선택해 자세히 보기</span></div>
      <div class="canvas" id="canvas" aria-label="노드 선택, 빈 곳 드래그로 이동. 확대 버튼 또는 Ctrl과 휠로 확대합니다.">
        <div class="world" id="world"><div class="lane-label" style="top:12px">01 / REQUIREMENTS</div><div class="lane-label" style="top:192px">02 / REVIEW &amp; EVIDENCE</div><div class="lane-label" style="top:372px">03 / HUMAN DECISION</div><div class="lane-divider" id="dependency-divider"></div><div class="lane-label" id="dependency-label" style="top:762px">CONNECTION POINTS / 실제 연결 전</div><svg class="connections" id="connections" viewBox="0 0 1090 900" aria-hidden="true"><defs><marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0L10 5L0 10Z" fill="#91a58c"/></marker><marker id="arrow-active" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0L10 5L0 10Z" fill="#245942"/></marker><marker id="arrow-revision" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0L10 5L0 10Z" fill="#72577d"/></marker></defs><g id="edge-paths"></g><g id="edge-labels"></g></svg><div id="nodes"></div></div>
        <div class="canvas-hint">드래그로 이동 · 노드 클릭으로 탐색 · Ctrl + 휠로 확대</div><div class="zoom-controls" aria-label="그래프 배율"><button type="button" id="zoom-out" aria-label="축소">−</button><output id="zoom-level">100%</output><button type="button" id="zoom-in" aria-label="확대">+</button><button type="button" class="fit" id="fit" aria-label="그래프 전체 맞춤">맞춤</button></div>
      </div>
      <div class="map-bottom"><span class="step-count" id="step-count">01 / 01</span><div class="step-text"><strong id="step-title">흐름 따라가기</strong><span id="step-description">설명용 탐색입니다. 실제 모델이나 API를 실행하지 않습니다.</span></div><div class="step-controls"><button class="small-button" id="previous" type="button" aria-label="이전 설명 단계">← 이전</button><button class="small-button primary-button" id="next" type="button">다음 단계 →</button><button class="small-button" id="reset" type="button" aria-label="설명 처음부터">처음</button></div></div>
    </section>
    <aside class="detail" aria-label="선택한 노드의 상세 정보"><div class="detail-head"><span>NODE INSPECTOR</span><span id="detail-order">01</span></div><div class="detail-body" id="detail-body"><div class="detail-code" id="detail-code">A01</div><h2 id="detail-title">실행 조정</h2><p class="detail-summary" id="detail-summary"></p><span class="detail-status" id="detail-status"></span><div class="detail-section"><h3>담당 영역</h3><p id="detail-owner"></p></div><div class="detail-section"><h3>입력 · 출력 계약</h3><div class="io-label">INPUT</div><div class="contract" id="detail-input"></div><div class="io-label">OUTPUT</div><div class="contract" id="detail-output"></div></div><div class="detail-section"><h3>현재 동작과 남은 연결</h3><ul id="detail-items"></ul></div><div class="detail-section"><h3>코드 근거</h3><div id="detail-files"></div></div><div class="detail-section"><h3>연결된 다음 단계</h3><div class="neighbours" id="detail-neighbours"></div></div></div><div class="detail-footer">개발용 메모리 실행기 · 합성 응답 기준<br>실제 Qwen·DB·MCP·front-v2는 연결 전입니다.</div></aside>
  </div>
  <div class="bottom-note"><p class="source-note">이 화면은 코드와 계획을 대조해 정리한 업무 흐름입니다. 승인 표시는 실제 사용자 승인이 아닌 개발용 입력입니다. 수정본은 새 실행으로 생성하며, 전체 조건을 다시 검사합니다.</p><p>PDF ONLY · QWEN · SQL / GRAPH RAG<br>VECTOR DB 없음 · PADDLEOCR 없음</p></div>
  <section class="code-map" aria-label="Graphify 코드 관계 지도"><div class="code-map-title">Under the flow.</div><p>Graphify가 실제 Python 코드에서 추출한 함수·클래스·호출 관계도 함께 확인할 수 있습니다.<small id="code-stats">코드 관계 지도는 업무 실행 순서와 구분됩니다.</small></p><a href="graphify-out/graph.html">Graphify 코드 지도 열기 ↗</a><a href="source.html?file=docs%2Fagent-framework%2Fgraphify-out%2FGRAPH_REPORT.md">추출 보고서 ↗</a></section>
  <div class="bottom-note"><p id="provenance">코드 기준 · feat/agent-framework</p><p>Offline HTML · 2026.11.02</p></div>
  <p class="sr-only" aria-live="polite" id="announcement"></p>
</main>
<script type="application/json" id="flow-data">__FLOW_DATA__</script>
<script type="application/json" id="code-graph-meta">__CODE_GRAPH_META__</script>
<script>
(() => {
  'use strict';
  const $ = id => document.getElementById(id);
  try {
    const data=JSON.parse($('flow-data').textContent), code=JSON.parse($('code-graph-meta').textContent);
    const positions={INPUT:[30,45],A01:[285,45],A02:[540,45],GATE_CRITERIA:[795,45],A03:[795,225],A04_05:[540,225],A06:[285,225],A07:[30,225],REPORT:[30,405],GATE_FINAL:[285,405],COMPLETE:[540,405],FAILURE:[795,405],GATE_CHANGES:[30,585],REVISION:[285,585],A08:[540,585],DEP_QWEN:[30,795],DEP_POSTGRES:[285,795],DEP_NEO4J:[540,795],DEP_MCP:[795,795]};
    const kindNames={agent:'AGENT',approval:'HUMAN GATE',input:'INPUT',output:'RESULT',dependency:'ADAPTER TARGET'};
    const statusNames={ready:'공통 기반 구현',adapter:'실제 구현 연결 자리',planned:'연결 예정'};
    const shortCodes={GATE_CRITERIA:'HUMAN 01',GATE_CHANGES:'HUMAN 02',GATE_FINAL:'HUMAN 03',A04_05:'A04 · A05',DEP_QWEN:'MODEL',DEP_POSTGRES:'SOURCE OF TRUTH',DEP_NEO4J:'GRAPH',DEP_MCP:'TOOL TRANSPORT'};
    const nodes=data.nodes.map(n=>({...n,x:(positions[n.id]||[n.x,n.y])[0],y:(positions[n.id]||[n.x,n.y])[1]}));
    const byId=new Map(nodes.map(n=>[n.id,n]));
    let selected='A01',scenario='pass',step=0,showDependencies=true,query='',scale=1,tx=0,ty=0,drag=null;
    const nodeElements=new Map(),edgeElements=[];
    const svgNS='http://www.w3.org/2000/svg';
    const pathFor=(e)=>{
      const a=byId.get(e.from),b=byId.get(e.to); const ah=a.kind==='dependency'?92:112,bh=b.kind==='dependency'?92:112;
      if(e.type==='revision' && e.from==='A08') return `M${a.x+204} ${a.y+56} H1050 V${b.y+56} H${b.x+204}`;
      if(e.type==='dependency') return `M${a.x+102} ${a.y+ah} C${a.x+102} ${a.y+ah+55},${b.x+102} ${b.y-55},${b.x+102} ${b.y}`;
      if(Math.abs(a.y-b.y)<30){const right=b.x>a.x;const x1=a.x+(right?204:0),x2=b.x+(right?0:204),y=a.y+56;return `M${x1} ${y} C${(x1+x2)/2} ${y},${(x1+x2)/2} ${b.y+56},${x2} ${b.y+56}`;}
      if(Math.abs(a.x-b.x)<30){const down=b.y>a.y;const x=a.x+102,y1=a.y+(down?ah:0),y2=b.y+(down?0:bh);return `M${x} ${y1} C${x} ${(y1+y2)/2},${b.x+102} ${(y1+y2)/2},${b.x+102} ${y2}`;}
      const x1=a.x+102,y1=a.y+ah,x2=b.x+102,y2=b.y;
      return `M${x1} ${y1} C${x1} ${(y1+y2)/2},${x2} ${(y1+y2)/2},${x2} ${y2}`;
    };
    function textEl(tag,text,className){const e=document.createElement(tag);e.textContent=text;if(className)e.className=className;return e;}
    nodes.forEach(n=>{
      const el=document.createElement('button');el.type='button';el.className=`node ${n.kind}`;el.style.left=n.x+'px';el.style.top=n.y+'px';el.dataset.id=n.id;el.setAttribute('aria-label',`${n.code||n.id} ${n.label}, ${statusNames[n.status]}`);el.setAttribute('aria-pressed','false');
      const top=textEl('span','', 'node-top');top.append(textEl('span',shortCodes[n.id]||n.id,'node-code'),textEl('span',n.status==='ready'?'기반 구현':n.status==='adapter'?'어댑터 연결':'미연결',`node-state ${n.status}`));
      el.append(top,textEl('span',n.label,'node-name'),textEl('span',kindNames[n.kind]||n.kind,'node-kind'));el.addEventListener('click',()=>select(n.id,true));$('nodes').append(el);nodeElements.set(n.id,el);
    });
    data.edges.forEach((e,index)=>{
      if(!byId.has(e.from)||!byId.has(e.to))throw new Error('그래프 연결 대상이 없습니다: '+e.from+' → '+e.to);
      const path=document.createElementNS(svgNS,'path');path.setAttribute('d',pathFor(e));path.classList.add('connection',e.type);path.setAttribute('marker-end',e.type==='revision'?'url(#arrow-revision)':'url(#arrow)');path.dataset.edge=index;$('edge-paths').append(path);
      let label=null;
      if(e.label&&e.type!=='dependency'){
        const a=byId.get(e.from),b=byId.get(e.to);label=document.createElementNS(svgNS,'text');label.classList.add('edge-label');if(e.type==='revision')label.classList.add('revision');
        let x=(a.x+b.x)/2+102,y=(a.y+b.y)/2+56;
        if(a.y===b.y){x=(a.x+b.x)/2+102;y=a.y-9;}
        else if(a.x===b.x){x=a.x+113;y=(a.y+112+b.y)/2+4;}
        if(e.from==='A08'&&e.type==='revision'){x=1038;y=550;label.setAttribute('transform',`rotate(-90 ${x} ${y})`);}
        label.setAttribute('x',x);label.setAttribute('y',y);label.setAttribute('text-anchor',a.x===b.x?'start':'middle');label.textContent=e.label.length>13?e.label.slice(0,12)+'…':e.label;$('edge-labels').append(label);
      }
      edgeElements.push({edge:e,path,label});
    });
    function scenarioPath(){const s=data.scenarios[scenario];return Array.isArray(s)?s:s.path;}
    function applyTransform(){$('world').style.transform=`translate(${tx}px,${ty}px) scale(${scale})`;$('zoom-level').value=Math.round(scale*100)+'%';}
    function fit(){const height=showDependencies?900:730;scale=Math.min(($('canvas').clientWidth-35)/1090,($('canvas').clientHeight-32)/height,1.2);tx=($('canvas').clientWidth-1090*scale)/2;ty=($('canvas').clientHeight-height*scale)/2;applyTransform();}
    function zoom(factor){const cx=$('canvas').clientWidth/2,cy=$('canvas').clientHeight/2,next=Math.max(.35,Math.min(1.8,scale*factor));tx=cx-(cx-tx)*next/scale;ty=cy-(cy-ty)*next/scale;scale=next;applyTransform();}
    function redraw(){
      const path=scenarioPath(),visited=new Set(path.slice(0,step+1));
      nodes.forEach(n=>{const el=nodeElements.get(n.id),match=!query||[n.id,n.label,n.summary,n.owner,n.input,n.output,JSON.stringify(n.files)].join(' ').toLowerCase().includes(query);el.classList.toggle('hidden',n.kind==='dependency'&&!showDependencies);el.classList.toggle('selected',n.id===selected);el.classList.toggle('dim',query?!match:!path.includes(n.id)&&n.kind!=='dependency'&&n.id!==selected);el.classList.toggle('search-match',Boolean(query&&match));el.classList.toggle('step-on',n.id===path[step]);el.setAttribute('aria-pressed',String(n.id===selected));});
      edgeElements.forEach(({edge:e,path:p,label})=>{let visible=e.type!=='dependency'||(showDependencies&&(e.from===selected||e.to===selected));if(e.to==='FAILURE'&&e.from!==selected&&e.to!==selected)visible=false;p.classList.toggle('hidden',!visible);let active=false;for(let i=0;i<step;i++)if(path[i]===e.from&&path[i+1]===e.to)active=true;p.classList.toggle('active',active);p.classList.toggle('dim',!active&&e.from!==selected&&e.to!==selected);p.setAttribute('marker-end',active?'url(#arrow-active)':e.type==='revision'?'url(#arrow-revision)':'url(#arrow)');if(label){label.classList.toggle('hidden',!visible||(e.from!==selected&&e.to!==selected));label.style.opacity='1';}});
      $('dependency-label').classList.toggle('hidden',!showDependencies);$('dependency-divider').classList.toggle('hidden',!showDependencies);
      const n=byId.get(path[step]);$('step-count').textContent=String(step+1).padStart(2,'0')+' / '+String(path.length).padStart(2,'0');$('step-title').textContent=(scenario==='unavailable'&&n.id==='A06'?'검색 불가 → 확인 필요 · ':n.code+' · ')+n.label;
      $('step-description').textContent=scenario==='unavailable'?'검색 불가는 통과가 아닙니다. review 판정 후 사람 검토에서 대기합니다.':'설명용 탐색 · 실제 API 호출 없이 연결 순서를 보여줍니다.';$('previous').disabled=step===0;$('next').disabled=step===path.length-1;
      const found=nodes.filter(n=>nodeElements.get(n.id).classList.contains('search-match')).length;$('filter-note').textContent=query?`${found}개 노드 일치`:'노드를 선택해 자세히 보기';
    }
    function select(id,announce=false){const n=byId.get(id);if(!n)return;selected=id;$('detail-code').textContent=n.code||n.id;$('detail-title').textContent=n.label;$('detail-summary').textContent=n.summary;$('detail-status').className='detail-status '+n.status;$('detail-status').textContent=statusNames[n.status];$('detail-owner').textContent=n.owner;$('detail-input').textContent=Array.isArray(n.input)?n.input.join(' · '):n.input;$('detail-output').textContent=Array.isArray(n.output)?n.output.join(' · '):n.output;$('detail-order').textContent=String(nodes.findIndex(x=>x.id===id)+1).padStart(2,'0')+' / '+nodes.length;
      $('detail-items').replaceChildren(...n.details.map(t=>textEl('li',t)));$('detail-files').replaceChildren(...n.files.map(f=>{const a=textEl('a',f.path+' : '+f.line,'source-link');a.href='source.html?file='+encodeURIComponent(f.path)+'#L'+f.line;return a;}));
      $('detail-neighbours').replaceChildren(...data.edges.filter(e=>e.from===id).map(e=>{const target=byId.get(e.to),button=textEl('button',target.label+' ↗');button.type='button';button.addEventListener('click',()=>{if(target.kind==='dependency'&&!showDependencies){showDependencies=true;$('show-dependencies').checked=true;fit();}select(target.id,true);});return button;}));
      $('detail-body').scrollTop=0;if(announce)$('announcement').textContent=n.label+' 선택. '+n.summary;redraw();
    }
    function setStep(next){step=Math.max(0,Math.min(scenarioPath().length-1,next));select(scenarioPath()[step],true);}
    document.querySelectorAll('[data-scenario]').forEach(b=>b.addEventListener('click',()=>{scenario=b.dataset.scenario;document.querySelectorAll('[data-scenario]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));setStep(0);}));
    $('next').addEventListener('click',()=>setStep(step+1));$('previous').addEventListener('click',()=>setStep(step-1));$('reset').addEventListener('click',()=>setStep(0));$('search').addEventListener('input',e=>{query=e.target.value.trim().toLowerCase();redraw();});
    $('show-dependencies').addEventListener('change',e=>{showDependencies=e.target.checked;redraw();fit();});$('zoom-in').addEventListener('click',()=>zoom(1.15));$('zoom-out').addEventListener('click',()=>zoom(1/1.15));$('fit').addEventListener('click',fit);
    $('canvas').addEventListener('pointerdown',e=>{if(e.target.closest('button')||e.button!==0)return;drag={x:e.clientX,y:e.clientY,tx,ty};$('canvas').setPointerCapture(e.pointerId);$('canvas').classList.add('dragging');});
    $('canvas').addEventListener('pointermove',e=>{if(!drag)return;tx=drag.tx+e.clientX-drag.x;ty=drag.ty+e.clientY-drag.y;applyTransform();});
    function endDrag(){drag=null;$('canvas').classList.remove('dragging');} $('canvas').addEventListener('pointerup',endDrag);$('canvas').addEventListener('pointercancel',endDrag);
    $('canvas').addEventListener('wheel',e=>{if(e.ctrlKey||e.metaKey){e.preventDefault();zoom(e.deltaY<0?1.05:1/1.05);}}, {passive:false});
    new ResizeObserver(fit).observe($('canvas'));
    $('node-count').textContent=String(nodes.length).padStart(2,'0');$('code-stats').textContent=`Graphify ${code.version} · Python ${code.files}개 · 노드 ${code.nodes}개 · 연결 ${code.edges}개. 추출 진단은 보고서에 포함됩니다.`;
    $('provenance').textContent=`feat/agent-framework · ${data.meta.basis||'현재 코드와 계획 기준'} · 설명 그래프 / 실행 모니터 아님`;
    fit();select('A01');
  }catch(error){$('load-error').textContent='흐름 자료를 읽지 못했습니다. 생성 파일을 다시 확인해 주세요.\n'+error.message;$('load-error').classList.remove('hidden');}
})();
</script>
</body>
</html>
