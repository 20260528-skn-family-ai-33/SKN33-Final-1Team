{
  "$defs": {
    "Context": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "project_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "run_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Run Id",
          "type": "string"
        },
        "actor_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Actor Id",
          "type": "string"
        },
        "document_version_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Document Version Id",
          "type": "string"
        },
        "criteria_version_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Criteria Version Id",
          "type": "string"
        },
        "asset_version_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Version Id"
        },
        "parent_run_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Run Id"
        }
      },
      "required": [
        "project_id",
        "run_id",
        "actor_id",
        "document_version_id",
        "criteria_version_id"
      ],
      "title": "Context",
      "type": "object"
    },
    "DocumentRef": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "file_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "File Id",
          "type": "string"
        },
        "document_version_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Document Version Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "media_type": {
          "const": "application/pdf",
          "default": "application/pdf",
          "title": "Media Type",
          "type": "string"
        },
        "page_count": {
          "minimum": 1,
          "title": "Page Count",
          "type": "integer"
        }
      },
      "required": [
        "file_id",
        "document_version_id",
        "sha256",
        "page_count"
      ],
      "title": "DocumentRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "synthetic": {
      "default": false,
      "title": "Synthetic",
      "type": "boolean"
    },
    "context": {
      "$ref": "#/$defs/Context"
    },
    "document": {
      "$ref": "#/$defs/DocumentRef"
    }
  },
  "required": [
    "context",
    "document"
  ],
  "title": "ExtractRequest",
  "type": "object"
}
