# Explicit worker profile. Never pass Compose owner/admin or web session secrets.
PERSISTENCE_MODE=postgres
APP_ENV=development
LOCAL_ADMIN_LOGIN=0
DB_HOST=127.0.0.1
DB_PORT=5432
POSTGRES_DB=creative_checker
DB_APP_USER=creative_checker_app
DB_APP_PASSWORD=change-me-app-password
DB_POOL_SIZE=5
STORAGE_ROOT=/absolute/private/storage
REVIEW_EXECUTOR=postgres_worker
REVIEW_PIPELINE=paddle-only
RUN_TARGET=local
# Fixed policy: heartbeat 15s, lease 90s, up to 3 attempts, pre-dispatch backoff 5/30s.
