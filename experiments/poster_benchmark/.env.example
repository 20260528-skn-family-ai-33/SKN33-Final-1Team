# Reference for RunPod Environment Variables / Raw editor. No real credentials.
# RunPod injects variables; these scripts do not automatically load .env files.
HF_TOKEN=
HF_HOME=/workspace/cache/huggingface
POSTER_VENV=/workspace/venvs/poster-benchmark
POSTER_BUNDLE_ARCHIVE=/workspace/runpod-poster-benchmark-2026-10-22.tar
POSTER_BUNDLE_DIR=/workspace/poster-benchmark-assets
POSTER_RUN_DIR=/workspace/poster-benchmark-runs
TOKENIZERS_PARALLELISM=false
PYTHONUNBUFFERED=1
CUBLAS_WORKSPACE_CONFIG=:4096:8
