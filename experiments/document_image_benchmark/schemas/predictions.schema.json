{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:creative-checker:document-image:predictions:v1",
  "title": "Condition decisions with execution state",
  "description": "Structural validation only. core.py and metrics.py additionally validate source contents, file hashes, identifiers, case/condition joins and packet binding.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "document-image-predictions-v1"
    },
    "packet_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "policy": {
      "type": "object",
      "additionalProperties": true
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prediction"
      }
    }
  },
  "required": [
    "schema",
    "packet_sha256",
    "results"
  ],
  "additionalProperties": true,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "outcome": {
      "type": "object",
      "properties": {
        "execution_status": {
          "enum": [
            "success",
            "error"
          ]
        },
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "review",
            null
          ]
        },
        "reason": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "execution_status",
        "verdict"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "execution_status": {
                "const": "success"
              }
            },
            "required": [
              "execution_status"
            ]
          },
          "then": {
            "properties": {
              "verdict": {
                "enum": [
                  "pass",
                  "fail",
                  "review"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "verdict": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "prediction": {
      "allOf": [
        {
          "$ref": "#/$defs/outcome"
        },
        {
          "type": "object",
          "properties": {
            "case_id": {
              "$ref": "#/$defs/text"
            },
            "condition_id": {
              "$ref": "#/$defs/text"
            },
            "image_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "level": {
              "enum": [
                "required",
                "recommended",
                "optional"
              ]
            },
            "requirement": {
              "$ref": "#/$defs/text"
            },
            "checks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/outcome"
              }
            },
            "provenance": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "required": [
            "case_id",
            "condition_id",
            "image_sha256"
          ],
          "additionalProperties": true
        }
      ]
    }
  }
}
