{
  "name": "baro-review-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test src/workflow.test.js src/auth/auth.test.js",
    "test:e2e": "node --test tests/e2e/login.spec.mjs",
    "test:e2e:local": "node --test tests/e2e/local-admin.spec.mjs",
    "dev:v1": "vite --mode v1 --host 127.0.0.1",
    "build:v1": "vite build --mode v1 --outDir dist-v1",
    "preview:v1": "vite preview --mode v1 --outDir dist-v1 --host 127.0.0.1",
    "test:v1": "node --test tests/v1/*.test.mjs",
    "test:e2e:v1": "node --test tests/v1/browser.spec.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "vite": "^7.1.7"
  }
}
