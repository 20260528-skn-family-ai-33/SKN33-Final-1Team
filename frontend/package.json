{
  "name": "baro-review-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test src/workflow.test.js src/documentRequirements.test.js src/documentProgress.test.js src/auth/auth.test.js src/hooks/useScrollScene.test.js src/components/imageStageGeometry.test.js src/pages/review/resultSelection.test.js src/pages/video/videoFormat.test.js src/pages/modeltest/modeltest.test.js src/pages/modeltest/modeltestBoard.test.js",
    "test:e2e": "node --test tests/e2e/login.spec.mjs",
    "test:e2e:local": "node --test tests/e2e/local-admin.spec.mjs",
    "dev:v1": "vite --mode v1 --host 127.0.0.1",
    "build:v1": "vite build --mode v1 --outDir dist-v1",
    "preview:v1": "vite preview --mode v1 --outDir dist-v1 --host 127.0.0.1",
    "test:v1": "node --test tests/v1/*.test.mjs",
    "test:e2e:v1": "node --test tests/v1/browser.spec.mjs",
    "dev:rebuild": "vite --mode rebuild --host 127.0.0.1",
    "build:rebuild": "tsc --noEmit && vite build --mode rebuild --outDir dist-rebuild",
    "preview:rebuild": "vite preview --mode rebuild --outDir dist-rebuild --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:modeltest:ui": "node --test --test-concurrency=1 tests/e2e/modeltest.spec.mjs tests/e2e/modeltest-board.spec.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "vite": "^7.1.7",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.3"
  }
}
