# Python
__pycache__/
*.py[cod]
.venv/
# Keep the previous local environment excluded during migration.
.venv-review/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node.js / TypeScript
node_modules/
*.tsbuildinfo

# Build and package output
build/
dist/
# 다른 빌드 산출물은 제외하고, 실행에 필요한 React 빌드는 함께 전달한다.
!/frontend/dist/
!/frontend/dist/**

# Logs and coverage
*.log
.coverage
.coverage.*
coverage/
htmlcov/

# Secrets and local environment
.env
.env.*
.env_*
*.env
*.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!*.env.example

# Local Docker volume data
/docker-data/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Local OCR models, uploaded files, and reproducible diagnostics
/.runtime/
/artifacts/

# RunPod poster experiment: download payloads; never commit keys or model outputs.
/experiments/poster_benchmark/assets/
/experiments/poster_benchmark/runs/
/experiments/poster_benchmark/.cache/
/experiments/poster_benchmark/.ocr-venv/
/experiments/poster_benchmark/*.tar*
*.gpu_owner.lock
# 로고 시드: 추출한 PNG만 추적한다. 큰 다운로드 아카이브·incoming 스테이징은 제외
data/logos/**/*.zip
data/logos/_incoming*/

# 관광 동영상 시드: 큰 영상 파일은 git 제외, 매니페스트(CSV)·README만 추적
data/videos/*.mp4
data/videos/*.mov
data/videos/*.webm
data/videos/*.m3u8
data/videos/*.ts
data/videos/_incoming*/
