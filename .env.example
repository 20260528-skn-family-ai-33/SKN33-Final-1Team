# This file is an example, not automatically loaded. Export only required values.
RUN_TARGET=local
OCR_ALLOW_DOWNLOAD=0
# 선택 모델은 수동 준비 후 사용한다. 기본값은 baseline.
# Paddle만으로 전체 이미지 탐지·인식 (EasyOCR 불필요)
# OCR_PIPELINE=paddle-only
# 기존 EasyOCR 탐지 + Paddle 재인식 비교 경로
# OCR_PIPELINE=paddle
# OCR_PIPELINE=qwen
# OCR_OLLAMA_URL=http://127.0.0.1:11435
# localhost 임시 로그인: admin / admin. 사용하지 않을 때 0으로 설정합니다.
LOCAL_ADMIN_LOGIN=1
# OCR_MODEL_DIR=/absolute/path/to/model-cache
# API_PROXY_TARGET=http://127.0.0.1:8000

# For an existing RunPod Serverless endpoint (server-side values only):
# RUN_TARGET=runpod
# RUNPOD_ENDPOINT_ID=your-endpoint-id
# RUNPOD_API_KEY=your-server-side-key
# RUNPOD_TIMEOUT_SECONDS=300
# RUNPOD_POLL_SECONDS=2
