# This file is an example, not automatically loaded. Export only required values.
RUN_TARGET=local
OCR_ALLOW_DOWNLOAD=0
# 로컬 기본값: paddle-only. 선택 모델은 수동 준비 후 사용한다.
# Paddle만으로 전체 이미지 탐지·인식 (EasyOCR 불필요). 별도 설정 없이 run.sh/run.cmd 실행.
# OCR_PIPELINE=paddle-only
# 조건별 Paddle 영역 재인식: 기본 활성화. 원래 전체 OCR만 비교하려면 0.
# OCR_CONDITION_RETRY=1
# EasyOCR 기준선으로 비교할 때만 명시
# OCR_PIPELINE=baseline
# 기존 EasyOCR 탐지 + Paddle 재인식 비교 경로
# OCR_PIPELINE=paddle
# OCR_PIPELINE=qwen
# OCR_OLLAMA_URL=http://127.0.0.1:11435
# PDF 페이지 이미지와 PaddleOCR 텍스트를 함께 읽어 위 로컬 Ollama로 조건 JSON을 추출합니다.
# REQUIREMENTS_LLM_MODEL=qwen3.5:4b
# 로컬 앱 실행 시 설치된 Ollama 자동 시작. 앱이 시작한 프로세스는 종료 시 함께 정리합니다.
# 별도 관리하는 경우 REQUIREMENTS_LLM_AUTOSTART=0
# localhost 임시 로그인: admin / admin. 사용하지 않을 때 0으로 설정합니다.
LOCAL_ADMIN_LOGIN=1
# OCR_MODEL_DIR=/absolute/path/to/model-cache
# API_PROXY_TARGET=http://127.0.0.1:8000

# For an existing RunPod Serverless endpoint (server-side values only):
# RUN_TARGET=runpod
# RunPod는 OCR_PIPELINE을 지정하지 않으면 baseline을 사용한다.
# RUNPOD_ENDPOINT_ID=your-endpoint-id
# RUNPOD_API_KEY=your-server-side-key
# RUNPOD_TIMEOUT_SECONDS=300
# RUNPOD_POLL_SECONDS=2

# Local PostgreSQL: copy this file to .env and replace all three passwords.
# Docker Compose reads .env automatically. C01 checks read it only with --env-file.
# The existing FastAPI API still uses JSON and does not load these DB settings.
# These credentials initialize an EMPTY volume only. Editing passwords in .env
# after initialization does not change the passwords stored in PostgreSQL.
DB_HOST=127.0.0.1
DB_PORT=5432
POSTGRES_DB=creative_checker
POSTGRES_PASSWORD=change-me-postgres-password
DB_OWNER_USER=creative_checker_owner
DB_OWNER_PASSWORD=change-me-owner-password
DB_APP_USER=creative_checker_app
DB_APP_PASSWORD=change-me-app-password

# Opt-in connection check only; keep legacy_json for the existing API profile.
PERSISTENCE_MODE=legacy_json
DB_CONNECT_TIMEOUT=5
DB_POOL_SIZE=5
DB_POOL_TIMEOUT=5

# Owner-only Alembic commands read a file only when explicitly selected.
# CC_MIGRATION_ENV_FILE=/absolute/path/to/owner-settings.env
