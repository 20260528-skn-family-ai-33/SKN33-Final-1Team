# Copy to .env.local or .env.staging; select explicitly with --env-file.
# Never add owner/admin or TEST_DB_* credentials here. Process variables take precedence.
# Local values below are examples. Use separate staging values and HTTPS.

# Rebuild API / worker / MCP / projection (separate database from the M008 profiles).
DATABASE_URL=postgresql+psycopg://checker:change-me-rebuild-password@127.0.0.1:25429/checker_rebuild
CC_DATA_DIR=data/creative_checker
CC_STORAGE_BACKEND=local
CC_COOKIE_SECURE=false
CC_SESSION_COOKIE=cc_session
CC_SESSION_HOURS=12
CC_NEO4J_URI=bolt://127.0.0.1:57629
CC_NEO4J_USER=neo4j
CC_NEO4J_PASSWORD=change-me-graph-password
CC_MCP_URL=http://127.0.0.1:8129/mcp
CC_MCP_TOKEN=change-me-use-a-random-token-at-least-32-characters
CC_QWEN_BASE_URL=
CC_QWEN_API_KEY=
CC_QWEN_MODEL=Qwen/Qwen3.5-4B
# Record the deployed weight revision; this declaration does not verify the model.
CC_QWEN_REVISION=unverified
# Framework worker also uses CC_QWEN_*; optional adapter limits:
# A04_A05_MODEL_TIMEOUT=120
# A04_A05_MODEL_MAX_PIXELS=2000000
# A04_A05_MODEL_BOX_FORMAT=normalized
CC_S3_BUCKET=
CC_S3_REGION=ap-northeast-2
# Staging: CC_STORAGE_BACKEND=s3, CC_COOKIE_SECURE=true, shared DB/S3 and internal MCP.
# CC_TLS_DIRECTORY=/absolute/private/tls

# Existing M008 API / framework / local web facade. Never point these at the rebuild DB.
PERSISTENCE_MODE=postgres
APP_ENV=development
LOCAL_ADMIN_LOGIN=0
DEV_PROJECT_ID=
DB_HOST=127.0.0.1
DB_PORT=5432
POSTGRES_DB=creative_checker
DB_APP_USER=creative_checker_app
DB_APP_PASSWORD=change-me-app-password
DB_CONNECT_TIMEOUT=5
DB_POOL_SIZE=5
DB_POOL_TIMEOUT=5
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_SECRET=change-me-distinct-random-secret-at-least-32-bytes
CURSOR_SECRET=change-me-another-random-secret-at-least-32-bytes
AUTH_SESSION_SECONDS=28800
AUTH_CSRF_SECONDS=900
AUTH_MAX_CONCURRENT_HASHES=2
WEB_CONCURRENCY=1
# STORAGE_ROOT=/absolute/private/storage
# FRONTEND_DIST=/absolute/repository/frontend/dist-v1
# TRUSTED_PROXY_IPS=172.20.0.2
# Queued v1 review: configure these two on BOTH web and worker; write the config explicitly.
# REVIEW_EXECUTOR=postgres_worker
# REVIEW_CONFIG_FILE=/absolute/private/worker-config.json
# Leave REVIEW_PIPELINE unset when sharing this file: web defaults to disabled,
# the v1 worker launcher defaults to paddle-only. Explicit invalid values are rejected.

# Legacy OCR / modeltest. Models are prepared separately, never downloaded at startup.
RUN_TARGET=local
OCR_ALLOW_DOWNLOAD=0
# OCR_PIPELINE=paddle-only
# OCR_CONDITION_RETRY=1
# OCR_MODEL_DIR=/absolute/path/to/model-cache
# OCR_OLLAMA_URL=http://127.0.0.1:11435
# REQUIREMENTS_LLM_MODEL=qwen3.5:4b
# REQUIREMENTS_LLM_AUTOSTART=0
# CC_WEB_POSTGRES_ENV_FILE=/absolute/private/runtime.env
# RUNPOD_ENDPOINT_ID=your-endpoint-id
# RUNPOD_API_KEY=your-server-side-key
# RUNPOD_TIMEOUT_SECONDS=300
# RUNPOD_POLL_SECONDS=2
# Frontend uses /api; API_PROXY_TARGET is a public dev-server override, not a browser secret.
# API_PROXY_TARGET=http://127.0.0.1:8000
