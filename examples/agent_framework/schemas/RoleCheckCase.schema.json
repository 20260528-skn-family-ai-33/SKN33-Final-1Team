{
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Id",
      "type": "string"
    },
    "input": {
      "minLength": 1,
      "title": "Input",
      "type": "string"
    },
    "expected_error": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{1,80}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Error"
    },
    "expected_verdict": {
      "anyOf": [
        {
          "enum": [
            "pass",
            "fail",
            "review"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Verdict"
    }
  },
  "required": [
    "id",
    "input"
  ],
  "title": "RoleCheckCase",
  "type": "object"
}
