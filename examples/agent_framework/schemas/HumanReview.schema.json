{
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "3.0.0",
      "default": "3.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "criterion_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Criterion Id",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "observed": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Observed",
      "type": "string"
    },
    "reference": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Reference",
      "type": "string"
    },
    "reason": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "checked_asset": {
      "title": "Checked Asset",
      "type": "boolean"
    }
  },
  "required": [
    "criterion_id",
    "verdict",
    "observed",
    "reference",
    "reason",
    "checked_asset"
  ],
  "title": "HumanReview",
  "type": "object"
}
