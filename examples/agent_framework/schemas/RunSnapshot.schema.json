{
  "$defs": {
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "actor_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Actor Id",
          "type": "string"
        },
        "decision": {
          "enum": [
            "approve_criteria",
            "approve_changes",
            "approve_final",
            "approve_exception"
          ],
          "title": "Decision",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "criterion_ids": {
          "default": [],
