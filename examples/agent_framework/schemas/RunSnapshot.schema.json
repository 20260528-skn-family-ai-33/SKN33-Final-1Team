            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Criterion Ids",
          "type": "array"
        }
      },
      "required": [
        "context",
        "actor_id",
        "decision"
      ],
      "title": "Approval",
      "type": "object"
    },
    "Context": {
      "additionalProperties": false,
