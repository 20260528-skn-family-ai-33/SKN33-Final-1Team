{
  "$defs": {
    "Context": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "project_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "run_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Run Id",
          "type": "string"
        },
        "actor_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Actor Id",
          "type": "string"
        },
        "document_version_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Document Version Id",
          "type": "string"
        },
        "criteria_version_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Criteria Version Id",
          "type": "string"
        },
        "asset_version_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Version Id"
        },
        "parent_run_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Run Id"
        }
      },
      "required": [
        "project_id",
        "run_id",
        "actor_id",
        "document_version_id",
        "criteria_version_id"
      ],
      "title": "Context",
      "type": "object"
    },
    "CriteriaValueSource": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "record_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Record Id",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "human_review",
            "synthetic_test"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "reference": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "quote": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "quote_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Quote Sha256",
          "type": "string"
        },
        "submitted_by": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Submitted By",
          "type": "string"
        },
        "submitted_at": {
          "format": "date-time",
          "title": "Submitted At",
          "type": "string"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "record_id",
        "purpose",
        "reference",
        "quote",
        "quote_sha256",
        "submitted_by",
        "submitted_at",
        "synthetic"
      ],
      "title": "CriteriaValueSource",
      "type": "object"
    },
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "criterion_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Criterion Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "enum": [
            "text",
            "number",
            "visual",
            "unsupported"
          ],
          "title": "Kind",
          "type": "string"
        },
        "expected": {
          "description": "Text equals/contains comparisons need a non-whitespace expected value. Blank expectations remain unresolved (review) and cannot pass.",
          "title": "Expected",
          "type": "string"
        },
        "operator": {
          "enum": [
            "equals",
            "contains",
            "gte",
            "lte",
            "present",
            "manual"
          ],
          "title": "Operator",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "human_added": {
          "default": false,
          "title": "Human Added",
          "type": "boolean"
        },
        "value_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/CriteriaValueSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "details": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequirementDetails"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "criterion_id",
        "text",
        "kind",
        "expected",
        "operator",
        "source"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "ExtractionRejection": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "candidate_index": {
          "maximum": 128,
          "minimum": 1,
          "title": "Candidate Index",
          "type": "integer"
        },
        "code": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Code",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "candidate_index",
        "code"
      ],
      "title": "ExtractionRejection",
      "type": "object"
    },
    "ExtractionTrace": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "mode": {
          "enum": [
            "mock",
            "qwen",
            "openai"
          ],
          "title": "Mode",
          "type": "string"
        },
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "parser": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Parser",
          "type": "string"
        },
        "policy": {
          "default": "a02-text-v1",
          "enum": [
            "a02-text-v1",
            "a02-source-compile-v2",
            "a02-semantic-v3",
            "a02-semantic-v4"
          ],
          "title": "Policy",
          "type": "string"
        },
        "input_kind": {
          "default": "pdf",
          "enum": [
            "pdf",
            "free_text"
          ],
          "title": "Input Kind",
          "type": "string"
        },
        "document_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Document Sha256",
          "type": "string"
        },
        "prompt_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "response_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Response Sha256",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/PDFTextSource"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "skipped_pdf_pages": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "maxItems": 49,
          "title": "Skipped Pdf Pages",
          "type": "array"
        },
        "unresolved_criterion_ids": {
          "default": [],
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Unresolved Criterion Ids",
          "type": "array"
        },
        "rejected_candidates": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExtractionRejection"
          },
          "maxItems": 128,
          "title": "Rejected Candidates",
          "type": "array"
        }
      },
      "required": [
        "mode",
        "model",
        "parser",
        "document_sha256",
        "prompt_sha256",
        "response_sha256",
        "sources"
      ],
      "title": "ExtractionTrace",
      "type": "object"
    },
    "PDFTextSource": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "page": {
          "maximum": 50,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "block_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Block Id",
          "type": "string"
        },
        "text": {
          "maxLength": 60000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "text_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Text Sha256",
          "type": "string"
        }
      },
      "required": [
        "page",
        "block_id",
        "text",
        "text_sha256"
      ],
      "title": "PDFTextSource",
      "type": "object"
    },
    "RequirementDetails": {
      "additionalProperties": false,
      "description": "Source-grounded compilation metadata, not semantic approval.",
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "compiler": {
          "default": "literal-requirements-v1",
          "enum": [
            "literal-requirements-v1",
            "qwen-semantic-v1"
          ],
          "title": "Compiler",
          "type": "string"
        },
        "target": {
          "enum": [
            "poster_text",
            "poster_visual",
            "file_metadata",
            "delivery",
            "unspecified"
          ],
          "title": "Target",
          "type": "string"
        },
        "field": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Field",
          "type": "string"
        },
        "expected_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "normalized_expected": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Expected"
        },
        "presentation": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequirementPresentation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "qualifiers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Qualifiers",
          "type": "array"
        },
        "origin": {
          "default": "selected_source",
          "enum": [
            "selected_source",
            "model_structured",
            "retained_unresolved_source"
          ],
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "target",
        "field"
      ],
      "title": "RequirementDetails",
      "type": "object"
    },
    "RequirementPresentation": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "label": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[^:\\r\\n]+$",
          "title": "Label",
          "type": "string"
        },
        "value": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "RequirementPresentation",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "document_version_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Document Version Id",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "block_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Block Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "source_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Hash",
          "type": "string"
        }
      },
      "required": [
        "document_version_id",
        "page",
        "block_id",
        "quote",
        "source_hash"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "3.0.0",
      "default": "3.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/Context"
    },
    "criteria": {
      "items": {
        "$ref": "#/$defs/Criterion"
      },
      "minItems": 1,
      "title": "Criteria",
      "type": "array"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "synthetic": {
      "default": false,
      "title": "Synthetic",
      "type": "boolean"
    },
    "extraction": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtractionTrace"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "context",
    "criteria"
  ],
  "title": "CriteriaDraft",
  "type": "object"
}
