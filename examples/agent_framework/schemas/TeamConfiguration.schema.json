{
  "$defs": {
    "PDFExtractionConfiguration": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "mode": {
          "enum": [
            "mock",
            "qwen"
          ],
          "title": "Mode",
          "type": "string"
        },
        "endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint"
        },
        "model": {
          "default": "Qwen/Qwen3.5-4B",
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "parser_version": {
          "default": "1.28.2",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Parser Version",
          "type": "string"
        },
        "max_text_chars": {
          "default": 32000,
          "maximum": 60000,
          "minimum": 100,
          "title": "Max Text Chars",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 120,
          "maximum": 600,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "max_output_tokens": {
          "default": 8192,
          "maximum": 16384,
          "minimum": 128,
          "title": "Max Output Tokens",
          "type": "integer"
        }
      },
      "required": [
        "mode"
      ],
      "title": "PDFExtractionConfiguration",
      "type": "object"
    },
    "RoleBinding": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "kind": {
          "enum": [
            "synthetic",
            "reference",
            "factory",
            "unconfigured",
            "registered_pdf",
            "registered_poster"
          ],
          "title": "Kind",
          "type": "string"
        },
        "factory": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Factory"
        },
        "scenario": {
          "anyOf": [
            {
              "enum": [
                "pass",
                "fail",
                "review",
                "stale",
                "unavailable"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario"
        }
      },
      "required": [
        "kind"
      ],
      "title": "RoleBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "profile": {
      "default": "development",
      "enum": [
        "development",
        "test"
      ],
      "title": "Profile",
      "type": "string"
    },
    "roles": {
      "additionalProperties": {
        "$ref": "#/$defs/RoleBinding"
      },
      "propertyNames": {
        "enum": [
          "A02",
          "A04_A05",
          "A06",
          "A07"
        ]
      },
      "title": "Roles",
      "type": "object"
    },
    "pdf_extraction": {
      "anyOf": [
        {
          "$ref": "#/$defs/PDFExtractionConfiguration"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "roles"
  ],
  "title": "TeamConfiguration",
  "type": "object"
}
