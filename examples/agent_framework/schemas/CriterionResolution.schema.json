      "type": "string"
    },
    "kind": {
      "enum": [
        "text",
        "number",
        "visual",
        "unsupported"
      ],
      "title": "Kind",
      "type": "string"
    },
    "operator": {
      "enum": [
        "equals",
        "contains",
        "gte",
        "lte",
        "present",
        "manual"
      ],
      "title": "Operator",
