# Explicit disposable-test settings only. Never pass this file to the web service.
# Copy to an ignored private file; set its permissions to owner-only.
TEST_DB_ALLOW_CREATE=1
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_ADMIN_USER=postgres
TEST_DB_ADMIN_PASSWORD=replace-test-admin-secret
TEST_DB_OWNER_USER=creative_checker_owner
TEST_DB_OWNER_PASSWORD=replace-test-owner-secret
TEST_DB_APP_USER=creative_checker_app
TEST_DB_APP_PASSWORD=replace-test-app-secret

# Enable only when selecting the HTTPS suite and after building the image.
C12_RUN_HTTPS=0
C12_API_IMAGE=creative-checker-v1:test
C12_CONTAINER_DB_HOST=host.docker.internal

# Opt-in real local Paddle models; never a default CI download/inference.
C12_RUN_REAL_OCR=0
# C13 separate production worker CLI + prepared local Paddle CPU (explicit opt-in).
C13_RUN_REAL_OCR=0
