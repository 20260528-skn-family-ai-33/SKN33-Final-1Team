# Path/image selection only. No DB, session, owner or admin secrets here.
# docker compose --env-file /absolute/private/deploy.env -f deploy/compose.v1.yaml -p cc-v1 config --quiet
CC_API_IMAGE=creative-checker-v1:reviewed-release
CC_WORKER_IMAGE=creative-checker-worker:reviewed-release
CC_WEB_ENV_FILE=/absolute/private/web.env
CC_WORKER_ENV_FILE=/absolute/private/worker.env
CC_FRONTEND_DIST=/absolute/release/frontend/dist-v1
CC_WORKER_CONFIG=/absolute/release/worker-config.json
CC_MODELS_DIR=/absolute/verified/paddle-models
CC_TLS_DIR=/absolute/private/tls
CC_SERVER_NAME=localhost
CC_BIND_IP=127.0.0.1
CC_HTTPS_PORT=8443
CC_SUBNET=172.30.215.0/24
CC_PROXY_IP=172.30.215.10
