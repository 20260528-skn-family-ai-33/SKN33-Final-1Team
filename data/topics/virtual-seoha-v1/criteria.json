{
  "dataset": "virtual-seoha-content-v1",
  "purpose": "가상 인간 모델 ‘서하’ 광고 이미지의 문구 검수용 개발·시연 데이터",
  "scope": "브랜드·상품명·가격·기간·AI 생성물 표시 문구만 검사. 가상 인물 설정 일치, 표시 글자 크기, 허락서 범위, IP·AI 도구 증빙은 앱이 검사하지 않음.",
  "rules": [
    {
      "id": "C01",
      "name": "브랜드 표기",
      "source_criterion": "H01",
      "expected": "MOA WATCH",
      "check": "근거 문구: 브랜드명은 항상 대문자 MOA WATCH로 쓴다.",
      "inspection": {
        "kind": "text",
        "contains": "[A-Za-z]",
        "region": [
          0.1575,
          0.0659,
          0.2932,
          0.037
        ]
      }
    },
    {
      "id": "C02",
      "name": "상품명",
      "source_criterion": "H02",
      "expected": "모아 워치 S1",
      "check": "근거 문구: 상품명은 “모아 워치 S1”로 표기한다.",
      "inspection": {
        "kind": "text",
        "contains": "[가-힣]",
        "region": [
          0.2653,
          0.1579,
          0.4684,
          0.0879
        ]
      }
    },
    {
      "id": "C03",
      "name": "가격",
      "source_criterion": "H03",
      "expected": "199,000원",
      "check": "근거 문구: 가격은 “199,000원”으로 표기한다.",
      "inspection": {
        "kind": "text",
        "contains": "[0-9]",
        "extract": "(?<![\\d,A-Za-z])\\d+(?:,\\d{3})*원",
        "normalize": "currency",
        "format": "\\d+원",
        "region": [
          0.6873,
          0.7178,
          0.2912,
          0.0681
        ]
      }
    },
    {
      "id": "C04",
      "name": "출시 기념 기간",
      "source_criterion": "H04",
      "expected": "11.16 ~ 12.15",
      "check": "근거 문구: 출시 기념 기간은 “11.16 ~ 12.15”로 표기한다.",
      "inspection": {
        "kind": "text",
        "contains": "[0-9]",
        "normalize": "time_dash",
        "format": "\\d{2}\\.\\d{2}-\\d{2}\\.\\d{2}",
        "region": [
          0.7107,
          0.787,
          0.2444,
          0.035
        ]
      }
    },
    {
      "id": "C05",
      "name": "AI 생성물 표시 문구",
      "source_criterion": "H05",
      "expected": "AI로 생성된 가상 인물입니다",
      "check": "근거 문구: 광고 이미지 하단에 “AI로 생성된 가상 인물입니다”를 표시한다.",
      "inspection": {
        "kind": "text",
        "contains": "[가-힣]",
        "region": [
          0.3112,
          0.8564,
          0.3757,
          0.036
        ]
      }
    },
    {
      "id": "C06",
      "name": "가상 인물 헤어(설정서 일치)",
      "source_criterion": "H07",
      "expected": "가상 인물 헤어: 검은 단발",
      "check": "자동 검사기를 연결하지 않은 항목이다. 사람이 확인해야 한다.",
      "inspection": {
        "kind": "manual"
      }
    },
    {
      "id": "C07",
      "name": "시계 착용 손목(설정서 일치)",
      "source_criterion": "H08",
      "expected": "시계 착용 손목: 왼쪽",
      "check": "자동 검사기를 연결하지 않은 항목이다. 사람이 확인해야 한다.",
      "inspection": {
        "kind": "manual"
      }
    }
  ],
  "common": "가상 브랜드·가상 행사·가상 인물의 합성 광고 이미지이며 실제 광고나 업무 자료가 아니다. 문구 영역은 이 이미지 레이아웃에 맞춘 설정이다.",
  "format_note": "실제 크기는 개별 파일 메타데이터로 기록한다(1080×1350 PNG). 원본은 data/virtual-orders/VO-03-virtual-person에 있다. sample-01~06은 D1~D6을 변경 없이 복사한 것이다.",
  "output_example": {
    "sample_id": "sample-XX",
    "results": [
      {
        "rule_id": "C01",
        "verdict": "충족 | 미충족 | 확인 필요",
        "observation": "관찰한 내용",
        "evidence": "이미지 내 위치"
      }
    ]
  }
}
