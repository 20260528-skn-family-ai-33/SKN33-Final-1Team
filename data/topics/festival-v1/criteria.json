{
  "dataset": "festival-content-v1",
  "purpose": "가상 음악 페스티벌 포스터 내용 검수용 개발·시연 데이터",
  "scope": "행사명·날짜·시간·장소·가격의 내용 검사만. 규격·저작권·원본보존·제작증빙·AI 사용 여부 판정은 제외.",
  "rules": [
    {
      "id": "C01",
      "name": "행사명",
      "expected": "노을 사운드 페스티벌",
      "check": "상단 큰 제목이 노을 사운드 페스티벌이어야 한다. 제목의 줄바꿈은 허용한다.",
      "inspection": {
        "kind": "text",
        "region": [
          0,
          0,
          1,
          0.28
        ],
        "contains": "[가-힣]",
        "join_lines": true
      }
    },
    {
      "id": "C02",
      "name": "행사 날짜",
      "expected": "2026.11.14",
      "check": "상단 제목 아래 행사 날짜가 2026.11.14로 표시되어야 한다.",
      "inspection": {
        "kind": "text",
        "region": [
          0,
          0.28,
          1,
          0.09
        ],
        "contains": "[0-9]",
        "normalize": "date",
        "format": "\\d{8}"
      }
    },
    {
      "id": "C03",
      "name": "운영 시간",
      "expected": "16:00–21:00",
      "check": "날짜 아래 운영 시간이 16:00부터 21:00까지여야 한다. 시간 구분선의 대시 종류와 주변 공백은 의미가 동일하면 허용한다.",
      "inspection": {
        "kind": "text",
        "region": [
          0,
          0.37,
          1,
          0.065
        ],
        "contains": "[0-9]",
        "normalize": "time_dash",
        "format": "\\d{2}:\\d{2}-\\d{2}:\\d{2}"
      }
    },
    {
      "id": "C04",
      "name": "행사 장소",
      "expected": "노을빛 공원",
      "check": "하단 장소명이 노을빛 공원으로 표시되어야 한다.",
      "inspection": {
        "kind": "text",
        "region": [
          0,
          0.8,
          1,
          0.1
        ],
        "contains": "[가-힣]"
      }
    },
    {
      "id": "C05",
      "name": "얼리버드 가격",
      "expected": "39,000원",
      "check": "하단 얼리버드 가격이 39,000원으로 표시되어야 한다.",
      "inspection": {
        "kind": "text",
        "region": [
          0,
          0.9,
          1,
          0.1
        ],
        "contains": "[0-9]",
        "extract": "(?<![\\d,A-Za-z])\\d+(?:,\\d{3})*원",
        "normalize": "currency",
        "format": "\\d+원"
      }
    }
  ],
  "common": "가상 행사·가상 장소의 AI 생성 포스터이며 실제 행사 안내가 아니다. 그림 스타일·악기 개수·풍경은 이 세트의 검사 조건에 포함되지 않는다.",
  "format_note": "실제 크기는 개별 파일 메타데이터로 기록한다. 기존 딸기라떼와 동일한 이미지 수량(6장)을 맞춘 내용 테스트이며 원 기획의 1080×1080 규격 조건은 변경하지 않는다.",
  "output_example": {
    "sample_id": "sample-XX",
    "results": [
      {
        "rule_id": "C01",
        "verdict": "충족 | 미충족 | 확인 필요",
        "observation": "관찰한 내용",
        "evidence": "이미지 내 위치"
      }
    ]
  }
}
