# Protected C14 owner-only management profile. Never pass to web/worker or commit real values.
DB_HOST=127.0.0.1
DB_PORT=5432
POSTGRES_DB=creative_checker
DB_OWNER_USER=creative_checker_owner
DB_OWNER_PASSWORD=change-me-owner-password
DB_APP_USER=creative_checker_app
IMPORT_ALLOWED_ROOT=/absolute/read-only/snapshots

# Choose explicit PostgreSQL 17 tools. Docker uses an already present image only.
PG_TOOLS_MODE=docker
PG_TOOLS_IMAGE=postgres:17.11-bookworm
PG_TOOLS_HOST=host.docker.internal
PG_TOOLS_PORT=5432
# Native alternative:
# PG_TOOLS_MODE=native
# PG_TOOLS_BIN=/absolute/postgresql-17/bin

# backup/restore take a separate --app-env-file; keep its session secrets private.
# Restore targets a DIFFERENT, EMPTY, template0-based DB and a NEW storage root.
