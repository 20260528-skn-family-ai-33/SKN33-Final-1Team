# Explicit protected management/migration environment only; never pass to web/worker.
DB_HOST=127.0.0.1
DB_PORT=5432
POSTGRES_DB=creative_checker
DB_OWNER_USER=creative_checker_owner
DB_OWNER_PASSWORD=change-me-owner-password
DB_APP_USER=creative_checker_app
# Development bootstrap only. Production account management does not enable this.
APP_ENV=development
LOCAL_ADMIN_LOGIN=1
DEV_PROJECT_ID=
