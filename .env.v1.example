# Explicit new auth profile only. Copy to an ignored .env.v1 file and replace secrets.
# Select with CC_APP_ENV_FILE; never merge the Compose owner/admin environment into web.
PERSISTENCE_MODE=postgres
APP_ENV=development
LOCAL_ADMIN_LOGIN=1
DEV_PROJECT_ID=
DB_HOST=127.0.0.1
DB_PORT=5432
POSTGRES_DB=creative_checker
DB_APP_USER=creative_checker_app
DB_APP_PASSWORD=change-me-app-password
DB_CONNECT_TIMEOUT=5
DB_POOL_SIZE=5
DB_POOL_TIMEOUT=5
AUTH_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
AUTH_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_SECRET=change-me-replace-with-a-random-secret
CURSOR_SECRET=change-me-replace-with-a-different-secret
AUTH_SESSION_SECONDS=28800
AUTH_CSRF_SECONDS=900
AUTH_MAX_CONCURRENT_HASHES=2
WEB_CONCURRENCY=1

# C09 opt-in. Initialize a NEW dedicated private directory explicitly first:
# .venv/bin/python -m backend.app.storage --root /absolute/private/storage init
# No root means the C08 authentication-only profile (no business routes).
# STORAGE_ROOT=/absolute/private/storage

# C10: explicit local adapter only; disabled leaves C09 APIs and existing history readable.
# No models/downloads/inference are run by the default disabled profile.
REVIEW_PIPELINE=disabled
# C13 durable queue (web does not load the model). Use the SAME storage/code/model
# configuration as the separate worker. Generate a NEW config file via worker --write-config.
# REVIEW_EXECUTOR=postgres_worker
# REVIEW_CONFIG_FILE=/absolute/private/worker-config.json
# REVIEW_PIPELINE=paddle-only
# RUN_TARGET=local

# C12 opt-in React build. Run npm run build:v1 first; legacy builds are rejected.
# FRONTEND_DIST=/absolute/repository/frontend/dist-v1
# Only production behind a private TLS proxy; list exact proxy IPs, never *.
# TRUSTED_PROXY_IPS=172.20.0.2
